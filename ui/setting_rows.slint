import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";

// The grammar of the settings screens (the iOS Settings app): a screen holds groups, a group holds
// rows, a row has its label on the left and its value or state and a ">" on the right.

// A rounded surface that holds rows.
export component Group inherits Rectangle {
    background: Theme.bubble;
    border-radius: 12px;
    clip: true;
    VerticalLayout {
        @children
    }
}

// A small grey heading above a group.
export component GroupTitle inherits Text {
    color: Theme.fg-secondary;
    font-size: 12px;
    height: 28px;
    vertical-alignment: bottom;
}

export component Row inherits Rectangle {
    in property <string> label;
    in property <string> sub;
    in property <string> value;
    // A thin usage bar inside the row; below 0 there is none
    in property <float> pct: -1;
    // Shows a ">": the row opens a next screen
    in property <bool> chevron: false;
    in property <bool> danger: false;
    in property <bool> clickable: true;
    in property <bool> separator: true;
    // A dot before the label: "ok", "warn" or "off"; "" for none
    in property <string> tone: "";
    in property <color> value-color: Theme.fg-secondary;
    callback clicked;

    height: max(48px, col.preferred-height + 20px);
    background: ta.has-hover && root.clickable ? Theme.hover : transparent;
    ta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 12px;
        spacing: 10px;
        if root.tone != "": Rectangle {
            width: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone == "ok" ? #3fb950 : root.tone == "warn" ? Theme.warning : Theme.fg-tertiary;
                }
            }
        }
        col := VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text { text: root.label; color: root.danger ? Theme.danger : Theme.fg; font-size: 14px; overflow: elide; }
            if root.sub != "": Text { text: root.sub; color: Theme.fg-secondary; font-size: 12px; overflow: elide; }
            if root.pct >= 0: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.pressed;
                Rectangle {
                    width: parent.width * max(0, min(100, root.pct)) / 100;
                    x: 0px;
                    border-radius: 2px;
                    background: root.pct >= 99.5 ? Theme.danger : root.pct >= 80 ? Theme.warning : #3fb950;
                }
            }
        }
        if root.value != "": Text {
            text: root.value;
            color: root.value-color;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
        if root.chevron: Icon {
            width: 18px;
            text: Glyph.chevron-right;
            font-size: 18px;
            color: Theme.fg-tertiary;
        }
    }
    if root.separator: Rectangle {
        x: 16px;
        y: parent.height - 1px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.border;
    }
}

// The top of a screen: the way back, named after the previous screen, and the title.
export component ScreenHead inherits VerticalLayout {
    in property <string> back-label;
    in property <string> title;
    callback back;
    spacing: 6px;
    if root.back-label != "": Rectangle {
        height: 30px;
        HorizontalLayout {
            alignment: start;
            spacing: 2px;
            Icon { width: 20px; text: Glyph.chevron-left; font-size: 22px; color: Theme.accent; }
            Text { text: root.back-label; color: Theme.accent; font-size: 14px; vertical-alignment: center; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.back(); } }
    }
    Text { text: root.title; color: Theme.fg; font-size: 24px; font-weight: 700; height: 40px; vertical-alignment: center; }
}
