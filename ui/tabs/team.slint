import { Theme } from "../theme.slint";
import { Tag } from "g_widgets.slint";
import { LogRow, LogList } from "log_rows.slint";

export struct AgentRow {
    name: string,
    paths: string,
    // running / waiting / blocked / done
    state: string,
    state-label: string,
    tokens: string,
    started: string,
}

export struct MetricRow {
    label: string,
    value: string,
}

export struct ThreadMetricRow {
    name: string,
    wall: string,
    tokens: string,
    waits: string,
    asks: string,
}

export global TeamState {
    // 測定の期間: 0 = 24 時間、1 = 7 日、2 = 30 日、3 = すべて
    in-out property <int> period: 0;
    out property <[string]> periods: ["24 時間", "7 日", "30 日", "すべて"];
    in property <[ThreadMetricRow]> thread-metrics;
    in property <[MetricRow]> history;
    in property <[MetricRow]> tasks;
    callback period-changed(int);
    // 停滞と相談役、やり取り、圧縮、退避した出力
    in property <[LogRow]> advisor;
    in property <[LogRow]> messages;
    in property <[string]> message-agents;
    in-out property <int> message-filter: 0;
    in property <[MetricRow]> compaction;
    in property <bool> breaker-tripped;
    in property <[LogRow]> outputs;
    callback advisor-toggled(int);
    callback advisor-action(int);
    callback message-toggled(int);
    callback message-action(int);
    callback message-filter-changed(int);
    callback output-toggled(int);
    in property <[AgentRow]> agents;
    in property <bool> has-estimate: false;
    in property <string> speedup;
    in property <string> cost;
    in property <string> decision;
    in property <string> reason;
    in property <[MetricRow]> metrics;
    in property <string> error;
    callback refresh;
}

component Heading inherits Text {
    color: Theme.fg;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
    height: 28px;
}

component KeyValue inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    height: 26px;
    Text { text: root.label; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; width: 140px; }
    Text { text: root.value; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
}

component AgentCard inherits Rectangle {
    in property <AgentRow> agent;
    property <bool> blocked: root.agent.state == "blocked";
    height: col.preferred-height;
    border-radius: Theme.radius-row + 2px;
    background: root.blocked ? Theme.danger.transparentize(0.88) : Theme.bubble;
    border-width: root.blocked ? 1px : 0px;
    border-color: Theme.danger;
    col := VerticalLayout {
        padding: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.agent.name;
                color: Theme.fg;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: root.agent.state-label;
                color: root.blocked ? Theme.danger
                    : root.agent.state == "running" ? Theme.accent
                    : root.agent.state == "waiting" ? Theme.warning
                    : Theme.fg-secondary;
                font-size: 12px;
                font-weight: root.blocked ? 700 : 500;
                vertical-alignment: center;
            }
        }
        Text { text: root.agent.paths; color: Theme.fg-secondary; font-size: 12px; overflow: elide; }
        HorizontalLayout {
            spacing: 16px;
            Text { text: root.agent.tokens; color: Theme.fg-tertiary; font-size: 12px; }
            Text { text: root.agent.started; color: Theme.fg-tertiary; font-size: 12px; }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component TeamTab inherits Rectangle {
    background: Theme.surface;
    Flickable {
        content-height: page.preferred-height;
        page := VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 24px;
            padding-top: 16px;
            spacing: 6px;

            if TeamState.error != "": Text {
                text: TeamState.error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }

            if TeamState.has-estimate: Heading { text: "見積もり"; }
            if TeamState.has-estimate: Rectangle {
                height: est.preferred-height;
                border-radius: Theme.radius-row + 2px;
                background: Theme.bubble;
                est := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    KeyValue { label: "判断"; value: TeamState.decision; }
                    KeyValue { label: "速度向上"; value: TeamState.speedup; }
                    KeyValue { label: "費用"; value: TeamState.cost; }
                    Text { text: TeamState.reason; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                }
            }
            if TeamState.tasks.length > 0: Rectangle { height: 8px; }
            if TeamState.tasks.length > 0: Heading { text: "検出した作業"; }
            if TeamState.tasks.length > 0: Rectangle {
                height: tk.preferred-height;
                border-radius: Theme.radius-row + 2px;
                background: Theme.bubble;
                tk := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    for t in TeamState.tasks: KeyValue { label: t.label; value: t.value; }
                }
            }

            if TeamState.agents.length > 0: Rectangle { height: 8px; }
            if TeamState.agents.length > 0: Heading { text: "社員"; }
            for agent in TeamState.agents: AgentCard { agent: agent; }

            Rectangle { height: 8px; }
            Heading { text: "測定"; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for p[i] in TeamState.periods: Tag {
                    label: p;
                    selected: TeamState.period == i;
                    clicked => { TeamState.period = i; TeamState.period-changed(i); }
                }
            }
            if TeamState.metrics.length > 0: Rectangle {
                height: mt.preferred-height;
                border-radius: Theme.radius-row + 2px;
                background: Theme.bubble;
                mt := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    for m in TeamState.metrics: KeyValue { label: m.label; value: m.value; }
                }
            }
            if TeamState.history.length > 0: Heading { text: "時間ごとの推移"; }
            if TeamState.history.length > 0: Rectangle {
                height: hs.preferred-height;
                border-radius: Theme.radius-row + 2px;
                background: Theme.bubble;
                hs := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    for h in TeamState.history: KeyValue { label: h.label; value: h.value; }
                }
            }
            if TeamState.thread-metrics.length > 0: Heading { text: "スレッド別"; }
            if TeamState.thread-metrics.length > 0: Rectangle {
                height: tm.preferred-height;
                border-radius: Theme.radius-row + 2px;
                background: Theme.bubble;
                tm := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    HorizontalLayout {
                        spacing: 10px;
                        height: 22px;
                        Text { text: "スレッド"; color: Theme.fg-tertiary; font-size: 11px; horizontal-stretch: 2; vertical-alignment: center; }
                        Text { text: "経過時間"; color: Theme.fg-tertiary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: "入力 / 出力"; color: Theme.fg-tertiary; font-size: 11px; horizontal-stretch: 1.6; vertical-alignment: center; }
                        Text { text: "wait_agent"; color: Theme.fg-tertiary; font-size: 11px; width: 70px; vertical-alignment: center; }
                        Text { text: "聞き返し"; color: Theme.fg-tertiary; font-size: 11px; width: 56px; vertical-alignment: center; }
                    }
                    for t in TeamState.thread-metrics: HorizontalLayout {
                        spacing: 10px;
                        height: 26px;
                        Text { text: t.name; color: Theme.fg; font-size: 12px; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                        Text { text: t.wall; color: Theme.fg; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                        Text { text: t.tokens; color: Theme.fg; font-size: 12px; horizontal-stretch: 1.6; vertical-alignment: center; overflow: elide; }
                        Text { text: t.waits; color: Theme.fg; font-size: 12px; width: 70px; vertical-alignment: center; }
                        Text { text: t.asks; color: Theme.fg; font-size: 12px; width: 56px; vertical-alignment: center; }
                    }
                }
            }

            if TeamState.advisor.length > 0: Rectangle { height: 8px; }
            if TeamState.advisor.length > 0: Heading { text: "停滞と相談"; }
            LogList {
                rows: TeamState.advisor;
                toggled(i) => { TeamState.advisor-toggled(i); }
                action(i) => { TeamState.advisor-action(i); }
            }

            if TeamState.messages.length > 0: Rectangle { height: 8px; }
            if TeamState.messages.length > 0: Heading { text: "やり取り"; }
            if TeamState.messages.length > 0: Flickable {
                height: 28px;
                content-width: agents.preferred-width;
                agents := HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for a[i] in TeamState.message-agents: Tag {
                        label: a;
                        selected: TeamState.message-filter == i;
                        clicked => { TeamState.message-filter = i; TeamState.message-filter-changed(i); }
                    }
                }
            }
            LogList {
                rows: TeamState.messages;
                toggled(i) => { TeamState.message-toggled(i); }
                action(i) => { TeamState.message-action(i); }
            }

            if TeamState.compaction.length > 0: Rectangle { height: 8px; }
            if TeamState.compaction.length > 0: Heading { text: "圧縮"; }
            if TeamState.compaction.length > 0: Rectangle {
                height: cp.preferred-height;
                border-radius: Theme.radius-row + 2px;
                background: TeamState.breaker-tripped ? Theme.danger.transparentize(0.88) : Theme.bubble;
                border-width: TeamState.breaker-tripped ? 1px : 0px;
                border-color: Theme.danger;
                cp := VerticalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    for c in TeamState.compaction: KeyValue { label: c.label; value: c.value; }
                }
            }

            if TeamState.outputs.length > 0: Rectangle { height: 8px; }
            if TeamState.outputs.length > 0: Heading { text: "退避した出力"; }
            LogList {
                rows: TeamState.outputs;
                mono-detail: true;
                toggled(i) => { TeamState.output-toggled(i); }
            }
        }
    }
}
