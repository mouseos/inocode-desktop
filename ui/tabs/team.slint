import { Theme } from "../theme.slint";
import { Tag } from "g_widgets.slint";
import { Icon } from "../icons.slint";
import { LogRow, LogList } from "log_rows.slint";

export struct AgentRow {
    name: string,
    paths: string,
    // running / waiting / blocked / done
    state: string,
    state-label: string,
    tokens: string,
    started: string,
}

// A point of the graph: x, y are 0..1 in the drawing; dy shifts it down (px); span is the width of its place (0..1).
export struct GraphNode {
    label: string,
    detail: string,
    state: string,
    main: bool,
    x: float,
    y: float,
    dy: float,
    span: float,
}

export struct GraphEdge {
    x1: float,
    y1: float,
    dy1: float,
    x2: float,
    y2: float,
    dy2: float,
    // an instruction is being passed: a dot runs from the first point to the second
    active: bool,
}

export struct MetricRow {
    label: string,
    value: string,
}

export struct ThreadMetricRow {
    name: string,
    wall: string,
    tokens: string,
    waits: string,
    asks: string,
}

export global TeamState {
    // 測定の期間: 0 = 24 時間、1 = 7 日、2 = 30 日、3 = すべて
    in-out property <int> period: 0;
    out property <[string]> periods: ["24 時間", "7 日", "30 日", "すべて"];
    in property <[ThreadMetricRow]> thread-metrics;
    in property <[MetricRow]> history;
    in property <[MetricRow]> tasks;
    callback period-changed(int);
    // 停滞と相談役、やり取り、圧縮、退避した出力
    in property <[LogRow]> advisor;
    in property <[LogRow]> messages;
    in property <[string]> message-agents;
    in-out property <int> message-filter: 0;
    in property <[MetricRow]> compaction;
    in property <bool> breaker-tripped;
    in property <[LogRow]> outputs;
    callback advisor-toggled(int);
    callback advisor-action(int);
    callback message-toggled(int);
    callback message-action(int);
    callback message-filter-changed(int);
    callback output-toggled(int);
    in property <[GraphNode]> graph-nodes;
    in property <[GraphEdge]> graph-edges;
    in property <float> graph-height: 0;
    callback graph-tick;
    in property <[AgentRow]> agents;
    // The same agents in groups: those that wait for a decision, those at work, those that are done.
    in property <[AgentRow]> attention;
    in property <[AgentRow]> active;
    in property <[AgentRow]> finished;
    // "3/8": agents that are done of all.
    in property <string> progress;
    in property <bool> has-estimate: false;
    in property <string> speedup;
    in property <string> cost;
    in property <string> decision;
    in property <string> reason;
    in property <[MetricRow]> metrics;
    in property <string> error;
    callback refresh;
}

component Heading inherits Text {
    color: Theme.fg;
    font-size: 12px;
    font-weight: 600;
    vertical-alignment: center;
    height: 28px;
}

component KeyValue inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    height: 26px;
    Text { text: root.label; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; width: 140px; }
    Text { text: root.value; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
}

// One agent as a cell of the grid: the colour is the state (done is a faint fill, running pulses).
component Cell inherits Rectangle {
    in property <string> state;
    in property <bool> pulse;
    width: 6px;
    height: 6px;
    border-radius: 1.5px;
    background: root.state == "running" ? Theme.accent
        : root.state == "waiting" ? Theme.warning
        : root.state == "blocked" ? Theme.danger
        : Theme.fg-tertiary.transparentize(0.55);
    opacity: root.state == "running" && root.pulse ? 0.72 : 1.0;
    animate opacity { duration: 1400ms; easing: ease-in-out; }
}

// The relations of the agents as points and lines. Lines that carry a message now have dots running on them.
component TeamGraph inherits Rectangle {
    property <int> hover: -1;
    property <float> phase: mod(animation-tick() / 1800ms, 1.0);
    height: TeamState.graph-height * 1px;
    pure function px(v: float) -> length { 40px + v * (root.width - 80px) }
    pure function py(v: float, dy: float) -> length { 18px + v * (root.height - 70px) + dy * 1px }

    for e in TeamState.graph-edges: Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        stroke: e.active ? Theme.accent : Theme.border;
        stroke-width: e.active ? 1.5px : 1px;
        MoveTo { x: root.px(e.x1) / 1px; y: root.py(e.y1, e.dy1) / 1px; }
        LineTo { x: root.px(e.x2) / 1px; y: root.py(e.y2, e.dy2) / 1px; }
    }
    for e in TeamState.graph-edges: Rectangle {
        // three dots, a third of a turn apart
        visible: e.active;
        for k in 3: Rectangle {
            property <float> t: mod(root.phase + k / 3.0, 1.0);
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.accent;
            x: root.px(e.x1) + (root.px(e.x2) - root.px(e.x1)) * self.t - 2.5px;
            y: root.py(e.y1, e.dy1) + (root.py(e.y2, e.dy2) - root.py(e.y1, e.dy1)) * self.t - 2.5px;
        }
    }
    for n[i] in TeamState.graph-nodes: Rectangle {
        property <length> r: n.main ? 7px : 6px;
        x: root.px(n.x) - self.r;
        y: root.py(n.y, n.dy) - self.r;
        width: self.r * 2;
        height: self.r * 2;
        border-radius: self.r;
        background: n.main ? Theme.fg-secondary
            : n.state == "running" ? Theme.accent
            : n.state == "waiting" ? Theme.warning
            : n.state == "blocked" ? Theme.danger
            : Theme.fg-tertiary.transparentize(0.55);
        TouchArea {
            changed has-hover => {
                if (self.has-hover) {
                    root.hover = i;
                } else if (root.hover == i) {
                    root.hover = -1;
                }
            }
        }
    }
    for n in TeamState.graph-nodes: Text {
        text: n.label;
        x: root.px(n.x) - self.width / 2;
        y: root.py(n.y, n.dy) + 10px;
        width: max(48px, n.span * (root.width - 80px));
        horizontal-alignment: center;
        color: Theme.fg-secondary;
        font-size: 10px;
        overflow: elide;
    }
    Text {
        x: 12px;
        y: root.height - 16px;
        width: root.width - 24px;
        text: root.hover >= 0 && root.hover < TeamState.graph-nodes.length ? TeamState.graph-nodes[root.hover].detail : "";
        color: Theme.fg-tertiary;
        font-size: 11px;
        overflow: elide;
    }
}

// An agent in a list: the state at the left, the name and what it owns, and when it started.
component AgentLine inherits Rectangle {
    in property <AgentRow> agent;
    in property <bool> pulse;
    property <bool> flagged: root.agent.state == "blocked" || root.agent.state == "waiting";
    height: row.preferred-height;
    border-radius: Theme.radius-row;
    background: root.agent.state == "blocked" ? Theme.danger.transparentize(0.9)
        : root.agent.state == "waiting" ? Theme.warning.transparentize(0.9)
        : transparent;
    row := HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Rectangle {
            width: 14px;
            if root.agent.state == "done": Icon { text: "\u{e5ca}"; font-size: 14px; color: Theme.fg-tertiary; }
            if root.agent.state != "done": Cell { state: root.agent.state; pulse: root.pulse; x: 4px; y: 8px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.agent.name;
                color: root.agent.state == "done" ? Theme.fg-secondary : Theme.fg;
                font-size: 13px;
                overflow: elide;
            }
            Text { text: root.agent.paths; color: Theme.fg-tertiary; font-size: 12px; overflow: elide; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            if root.flagged: Text {
                text: root.agent.state-label;
                color: root.agent.state == "blocked" ? Theme.danger : Theme.warning;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
            }
            Text { text: root.agent.started; color: Theme.fg-tertiary; font-size: 11px; horizontal-alignment: right; }
        }
    }
}

// A small heading over a group of agents: the group and how many.
component GroupHead inherits Text {
    in property <int> count;
    in property <string> group;
    text: root.group + " " + root.count;
    color: Theme.fg-tertiary;
    font-size: 11px;
    vertical-alignment: center;
    height: 26px;
}

// The measures of the team (estimate, counters, history, per thread): shown in the statistics screen.
export component TeamMetrics inherits VerticalLayout {
    spacing: 6px;
    if TeamState.error != "": Text {
        text: TeamState.error;
        color: Theme.danger;
        font-size: 12px;
        wrap: word-wrap;
    }
    if TeamState.has-estimate: Heading { text: "チームの見積もり"; }
    if TeamState.has-estimate: Rectangle {
        height: est.preferred-height;
        border-radius: Theme.radius-row + 2px;
        background: Theme.bubble;
        est := VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            KeyValue { label: "判断"; value: TeamState.decision; }
            KeyValue { label: "速度向上"; value: TeamState.speedup; }
            KeyValue { label: "費用"; value: TeamState.cost; }
            Text { text: TeamState.reason; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
        }
    }
    if TeamState.tasks.length > 0: Rectangle { height: 8px; }
    if TeamState.tasks.length > 0: Heading { text: "検出した作業"; }
    if TeamState.tasks.length > 0: Rectangle {
        height: tk.preferred-height;
        border-radius: Theme.radius-row + 2px;
        background: Theme.bubble;
        tk := VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            for t in TeamState.tasks: KeyValue { label: t.label; value: t.value; }
        }
    }


    Rectangle { height: 8px; }
    Heading { text: "測定"; }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for p[i] in TeamState.periods: Tag {
            label: p;
            selected: TeamState.period == i;
            clicked => { TeamState.period = i; TeamState.period-changed(i); }
        }
    }
    if TeamState.metrics.length > 0: Rectangle {
        height: mt.preferred-height;
        border-radius: Theme.radius-row + 2px;
        background: Theme.bubble;
        mt := VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            for m in TeamState.metrics: KeyValue { label: m.label; value: m.value; }
        }
    }
    if TeamState.history.length > 0: Heading { text: "時間ごとの推移"; }
    if TeamState.history.length > 0: Rectangle {
        height: hs.preferred-height;
        border-radius: Theme.radius-row + 2px;
        background: Theme.bubble;
        hs := VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            for h in TeamState.history: KeyValue { label: h.label; value: h.value; }
        }
    }
    if TeamState.thread-metrics.length > 0: Heading { text: "スレッド別"; }
    if TeamState.thread-metrics.length > 0: Rectangle {
        height: tm.preferred-height;
        border-radius: Theme.radius-row + 2px;
        background: Theme.bubble;
        tm := VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            padding-right: 14px;
            HorizontalLayout {
                spacing: 10px;
                height: 22px;
                Text { text: "スレッド"; color: Theme.fg-tertiary; font-size: 11px; horizontal-stretch: 2; vertical-alignment: center; }
                Text { text: "経過時間"; color: Theme.fg-tertiary; font-size: 11px; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: "入力 / 出力"; color: Theme.fg-tertiary; font-size: 11px; horizontal-stretch: 1.6; vertical-alignment: center; }
                Text { text: "wait_agent"; color: Theme.fg-tertiary; font-size: 11px; width: 70px; vertical-alignment: center; }
                Text { text: "聞き返し"; color: Theme.fg-tertiary; font-size: 11px; width: 56px; vertical-alignment: center; }
            }
            for t in TeamState.thread-metrics: HorizontalLayout {
                spacing: 10px;
                height: 26px;
                Text { text: t.name; color: Theme.fg; font-size: 12px; horizontal-stretch: 2; vertical-alignment: center; overflow: elide; }
                Text { text: t.wall; color: Theme.fg; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                Text { text: t.tokens; color: Theme.fg; font-size: 12px; horizontal-stretch: 1.6; vertical-alignment: center; overflow: elide; }
                Text { text: t.waits; color: Theme.fg; font-size: 12px; width: 70px; vertical-alignment: center; }
                Text { text: t.asks; color: Theme.fg; font-size: 12px; width: 56px; vertical-alignment: center; }
            }
        }
    }

}

// A heading that opens and closes what is under it (closed at first).
component Fold inherits VerticalLayout {
    in property <string> title;
    in-out property <bool> open: false;
    spacing: 4px;
    Rectangle {
        height: 30px;
        HorizontalLayout {
            spacing: 6px;
            Icon { width: 16px; text: root.open ? "\u{e5cf}" : "\u{e5cc}"; font-size: 16px; color: Theme.fg-tertiary; }
            Text { text: root.title; color: Theme.fg-secondary; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
    }
    // closed: no height, so nothing of it shows
    Rectangle {
        height: root.open ? inner.preferred-height : 0px;
        clip: true;
        inner := VerticalLayout {
            width: parent.width;
            spacing: 6px;
            @children
        }
    }
}

export component TeamTab inherits Rectangle {
    background: Theme.surface;
    // The running cells pulse slowly.
    property <bool> pulse: false;
    // The agent under the pointer in the grid (-1: none).
    property <int> hover: -1;
    Timer {
        interval: 1400ms;
        running: TeamState.agents.length > 0;
        triggered => { root.pulse = !root.pulse; }
    }
    // lines that carried a message a while ago stop moving
    Timer {
        interval: 5s;
        running: TeamState.graph-edges.length > 0;
        triggered => { TeamState.graph-tick(); }
    }
    Flickable {
        content-height: page.preferred-height;
        page := VerticalLayout {
            width: parent.width;
            alignment: start;
            padding: 24px;
            padding-top: 16px;
            spacing: 6px;

            if TeamState.graph-edges.length > 0: TeamGraph { }
            if TeamState.error != "": Text {
                text: TeamState.error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }

            // No agent: one quiet line, as the lists of other agents have it when they are empty.
            if TeamState.agents.length == 0: Text {
                text: "実行中のエージェントはいません";
                color: Theme.fg-tertiary;
                font-size: 13px;
                height: 40px;
                vertical-alignment: center;
            }
            if TeamState.agents.length > 0: Rectangle { height: 8px; }
            if TeamState.agents.length > 0: HorizontalLayout {
                spacing: 12px;
                padding-left: 12px;
                padding-bottom: 6px;
                height: (floor((TeamState.agents.length - 1) / 35) + 1) * 8px + 12px;
                // 35 cells in a row, 8px apart (6px and a gap of 2px)
                Rectangle {
                    width: min(TeamState.agents.length, 35) * 8px;
                    height: (floor((TeamState.agents.length - 1) / 35) + 1) * 8px + 12px;
                    for a[i] in TeamState.agents: Cell {
                        x: mod(i, 35) * 8px;
                        y: floor(i / 35) * 8px + 3px;
                        state: a.state;
                        pulse: root.pulse;
                        TouchArea {
                            changed has-hover => {
                                if (self.has-hover) {
                                    root.hover = i;
                                } else if (root.hover == i) {
                                    root.hover = -1;
                                }
                            }
                        }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.hover >= 0 && root.hover < TeamState.agents.length
                        ? TeamState.agents[root.hover].name + "  " + TeamState.agents[root.hover].state-label + "  " + TeamState.agents[root.hover].tokens
                        : TeamState.progress;
                    color: Theme.fg-tertiary;
                    font-size: 11px;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    overflow: elide;
                }
            }
            for agent in TeamState.attention: AgentLine { agent: agent; pulse: root.pulse; }
            if TeamState.active.length > 0: GroupHead { group: "実行中"; count: TeamState.active.length; }
            for agent in TeamState.active: AgentLine { agent: agent; pulse: root.pulse; }
            if TeamState.finished.length > 0: GroupHead { group: "完了"; count: TeamState.finished.length; }
            for agent in TeamState.finished: AgentLine { agent: agent; pulse: root.pulse; }


            if TeamState.messages.length > 0: Fold {
                title: "やり取り";
                if TeamState.messages.length > 0: Flickable {
                    height: 28px;
                    content-width: agents.preferred-width;
                    agents := HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        for a[i] in TeamState.message-agents: Tag {
                            label: a;
                            selected: TeamState.message-filter == i;
                            clicked => { TeamState.message-filter = i; TeamState.message-filter-changed(i); }
                        }
                    }
                }
                LogList {
                    rows: TeamState.messages;
                    toggled(i) => { TeamState.message-toggled(i); }
                    action(i) => { TeamState.message-action(i); }
                }
            }
            if TeamState.advisor.length > 0: Fold {
                title: "停滞と相談";
                LogList {
                    rows: TeamState.advisor;
                    toggled(i) => { TeamState.advisor-toggled(i); }
                    action(i) => { TeamState.advisor-action(i); }
                }
            }
            if TeamState.compaction.length > 0: Fold {
                title: "圧縮";
                if TeamState.compaction.length > 0: Rectangle {
                    height: cp.preferred-height;
                    border-radius: Theme.radius-row + 2px;
                    background: TeamState.breaker-tripped ? Theme.danger.transparentize(0.88) : Theme.bubble;
                    border-width: TeamState.breaker-tripped ? 1px : 0px;
                    border-color: Theme.danger;
                    cp := VerticalLayout {
                        padding: 10px;
                        padding-left: 14px;
                        padding-right: 14px;
                        for c in TeamState.compaction: KeyValue { label: c.label; value: c.value; }
                    }
                }
            }
            if TeamState.outputs.length > 0: Fold {
                title: "退避した出力";
                LogList {
                    rows: TeamState.outputs;
                    mono-detail: true;
                    toggled(i) => { TeamState.output-toggled(i); }
                }
            }
        }
    }
}
