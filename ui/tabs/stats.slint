import { Theme } from "../theme.slint";
import { Tag, Button, LineEdit } from "g_widgets.slint";

// 統計の画面(設定の「InoCode」群)。値はすべてサーバーの統計 RPC(inocode/stats/*)から来る。
// このファイルと src/tabs/stats.rs だけを編集して実装する。

// モデル別の表の 1 行
export struct StatsModel {
    name: string,
    uncached: string,
    cached: string,
    output: string,
    q5: string,
    qw: string,
    speed: string,
    per-million: string,
    selected: bool,
}

// 棒グラフの 1 本(時間帯ごと / 日ごと)
export struct StatsBar {
    top: string,
    label: string,
    sub: string,
    ratio: float,
    faint: bool,
}

export global StatsState {
    // 0 = 直近 3 日、1 = 7 日、2 = 30 日
    in-out property <int> period: 0;
    in property <[string]> periods: ["直近3日", "7日", "30日"];
    in property <[StatsModel]> models;
    in property <string> selected-model;
    in property <[StatsBar]> hours;
    in property <[StatsBar]> days;
    in property <string> note;
    in property <bool> empty: false;
    in-out property <string> est-model;
    in-out property <string> est-uncached;
    in-out property <string> est-cached;
    in-out property <string> est-output;
    in property <string> est-result;
    in property <bool> seeding: false;
    in property <string> seed-text;
    in property <float> seed-ratio: 0;
    callback refresh();
    callback set-period(int);
    callback select-model(string);
    callback estimate();
    callback seed();
}

component Heading inherits Text {
    color: Theme.fg;
    font-size: 13px;
    font-weight: 600;
    vertical-alignment: center;
    height: 28px;
}

component Cell inherits Text {
    color: Theme.fg;
    font-size: 12px;
    vertical-alignment: center;
    horizontal-alignment: right;
    width: 64px;
}

component Bars inherits Rectangle {
    in property <[StatsBar]> bars;
    in property <length> plot: 90px;
    height: root.plot + 54px;
    HorizontalLayout {
        spacing: 3px;
        for b in root.bars: VerticalLayout {
            Text { text: b.top; color: Theme.fg-secondary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; height: 18px; overflow: elide; }
            Rectangle {
                height: root.plot;
                Rectangle {
                    height: b.ratio > 0 ? max(parent.height * b.ratio, 2px) : 0px;
                    y: parent.height - self.height;
                    border-radius: 2px;
                    background: Theme.accent;
                    opacity: b.faint ? 0.3 : 1.0;
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Text { text: b.label; color: Theme.fg-tertiary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; height: 16px; overflow: elide; }
            Text { text: b.sub; color: Theme.fg-tertiary; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; height: 16px; overflow: elide; }
        }
    }
}

export component StatsPage inherits Rectangle {
    init => { StatsState.refresh(); }
    Flickable {
        content-height: page.preferred-height;
        page := VerticalLayout {
            x: 0px;
            width: min(parent.width, 820px);
            alignment: start;
            padding: 24px;
            padding-left: 40px;
            padding-right: 40px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                height: 40px;
                Text { text: "統計"; color: Theme.fg; font-size: 20px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                for p[i] in StatsState.periods: VerticalLayout {
                    alignment: center;
                    Tag { label: p; selected: StatsState.period == i; clicked => { StatsState.set-period(i); } }
                }
            }
            if StatsState.note != "": Text { text: StatsState.note; color: Theme.danger; font-size: 12px; wrap: word-wrap; }

            Heading { text: "モデル別"; }
            if StatsState.empty: Text { text: "この期間の記録がありません"; color: Theme.fg-tertiary; font-size: 12px; }
            if !StatsState.empty: VerticalLayout {
                HorizontalLayout {
                    spacing: 6px;
                    height: 22px;
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: "モデル"; color: Theme.fg-tertiary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                    Cell { text: "入力"; color: Theme.fg-tertiary; font-size: 11px; }
                    Cell { text: "キャッシュ"; color: Theme.fg-tertiary; font-size: 11px; }
                    Cell { text: "出力"; color: Theme.fg-tertiary; font-size: 11px; }
                    Cell { text: "5時間枠"; color: Theme.fg-tertiary; font-size: 11px; }
                    Cell { text: "週枠"; color: Theme.fg-tertiary; font-size: 11px; }
                    Cell { text: "tok/s"; color: Theme.fg-tertiary; font-size: 11px; }
                }
                for m in StatsState.models: Rectangle {
                    border-radius: Theme.radius-row;
                    background: m.selected ? Theme.selected : ma.has-hover ? Theme.hover : transparent;
                    height: rowcol.preferred-height;
                    rowcol := VerticalLayout {
                        padding: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 6px;
                            height: 22px;
                            Text { text: m.name; color: Theme.fg; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            Cell { text: m.uncached; }
                            Cell { text: m.cached; }
                            Cell { text: m.output; }
                            Cell { text: m.q5; }
                            Cell { text: m.qw; }
                            Cell { text: m.speed; }
                        }
                        Text { text: m.per-million; color: Theme.fg-secondary; font-size: 11px; wrap: word-wrap; }
                    }
                    ma := TouchArea { mouse-cursor: pointer; clicked => { StatsState.select-model(m.name); } }
                }
            }

            Rectangle { height: 8px; }
            Heading { text: StatsState.selected-model == "" ? "時間帯ごとの速度(tok/s)" : "時間帯ごとの速度(tok/s) · " + StatsState.selected-model; }
            Bars { bars: StatsState.hours; }

            Rectangle { height: 8px; }
            Heading { text: "日ごとの推移(5時間枠の消費)"; }
            Bars { bars: StatsState.days; }

            Rectangle { height: 8px; }
            Heading { text: "見積もり"; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for m in StatsState.models: Tag {
                    label: m.name;
                    selected: StatsState.est-model == m.name;
                    clicked => { StatsState.est-model = m.name; }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "入力"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                LineEdit { text <=> StatsState.est-uncached; horizontal-stretch: 1; }
                Text { text: "キャッシュ"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                LineEdit { text <=> StatsState.est-cached; horizontal-stretch: 1; }
                Text { text: "出力"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                LineEdit { text <=> StatsState.est-output; horizontal-stretch: 1; }
                Button { label: "見積もる"; primary: true; clicked => { StatsState.estimate(); } }
            }
            if StatsState.est-result != "": Text { text: StatsState.est-result; color: Theme.fg; font-size: 13px; wrap: word-wrap; }

            Rectangle { height: 8px; }
            Heading { text: "過去の Codex の履歴から取り込む"; }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                height: 28px;
                Button { label: StatsState.seeding ? "取り込み中…" : "取り込む"; clicked => { if !StatsState.seeding { StatsState.seed(); } } }
                if StatsState.seeding: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 200px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.hover;
                        Rectangle {
                            x: 0px;
                            width: parent.width * StatsState.seed-ratio;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                }
                if StatsState.seed-text != "": Text { text: StatsState.seed-text; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
            }
        }
    }
}
