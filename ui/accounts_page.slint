import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Switch } from "widgets.slint";
import { Chip, Field } from "controls.slint";
import { Group, GroupTitle, Row, ScreenHead, Dropdown, RowBar, ActionButton } from "setting_rows.slint";

export struct AcctBar {
    label: string,
    pct: float,
    reset: string,
}

// One reset credit.
export struct GrantRow {
    id: string,
    title: string,
    // "有効期限 11/16 3:00" or ""
    expires: string,
    usable: bool,
}

// A line of the reset-credit history.
export struct HistRow {
    when: string,
    // "付与された", "使った(このアプリから)", ...
    kind: string,
    title: string,
    detail: string,
}

export struct AcctCard {
    id: string,
    alias: string,
    email: string,
    owner: string,
    provider: string,
    // "ChatGPT", "サブスク" or "API キー"
    kind-label: string,
    plan: string,
    // The state in a few words: 使用中, 使用できます, 上限に達しています, 今は使えません, 停止中
    badge: string,
    // "あと1時間20分で回復" or ""
    recover: string,
    // "ok", "warn" or "off"
    tone: string,
    in-use: bool,
    enabled: bool,
    can-reauth: bool,
    bars: [AcctBar],
    // The reset-credit block: shown at all, how many can be used, a line instead of credits, the credits
    credit-shown: bool,
    credit-count: int,
    credit-line: string,
    grants: [GrantRow],
    // A reset credit can be used now, and how many are left
    credit-usable: bool,
    credit-left: int,
}

// A setting of one provider (a choice among a few values).
export struct ProvSetting {
    key: string,
    title: string,
    desc: string,
    value: string,
    opts: [string],
}

// A row of the top level: one provider.
export struct ProvRow {
    id: string,
    name: string,
    count: int,
    // The mean usage of the provider's accounts: 5 hours and the week; none when it reports none
    bars: [RowBar],
    // The base URL of a provider added through the config
    summary: string,
    // "ok", "warn" or "off"
    tone: string,
}

export struct AddRow {
    // "chatgpt", "claude" or "key:<provider id>"
    id: string,
    title: string,
    kind: string,
    provider: string,
}

// The account screens (src/accounts_page.rs), three levels: the providers, the accounts of one
// provider, one account. Each level is a screen of its own with a way back to the one above.
export global AccountsState {
    in property <[AcctCard]> cards;
    in property <AcctCard> cur;
    in property <[ProvRow]> provs;
    in property <[ProvSetting]> settings;
    // The open provider: does it sign in through the account pool, and its connection (config)
    in property <bool> pooled: true;
    in property <string> endpoint-url;
    in property <bool> has-endpoint: false;
    in property <bool> is-default: false;
    // The form of an OpenAI-compatible provider
    in-out property <string> np-name;
    in-out property <string> np-url;
    in-out property <string> np-env;
    in-out property <string> np-key;
    in property <bool> loading: false;
    in property <string> note;
    // The whole text of the error behind the note, shown on request
    in property <string> note-detail;
    in-out property <bool> detail-open: false;
    // The server does not know the account methods (an older inocode.exe)
    in property <bool> unsupported: false;
    // Where we are: "" for the top level; the provider; then the account
    in-out property <string> provider-id;
    in property <string> provider-name;
    in-out property <string> account-id;
    in-out property <bool> reorder: false;
    in property <[RowBar]> total;
    in-out property <string> threshold;
    in-out property <string> confirm-id;
    // The credit whose button was pressed once (it asks to be pressed again), and what came of it
    in-out property <string> credit-confirm-id;
    in property <string> credit-result;
    in-out property <string> rename-text;
    // The history of the reset credits (a modal): open, loading, what the server sent, a failure
    in-out property <bool> history-open: false;
    in property <bool> history-loading: false;
    in property <[HistRow]> history;
    in property <string> history-error;
    // The add dialog: 0 closed, 1 list, 2 form
    in-out property <int> add-step: 0;
    in-out property <string> add-kind;
    in-out property <string> add-title;
    in-out property <string> search;
    in property <[AddRow]> add-rows;
    in-out property <string> add-alias;
    in-out property <string> add-key;
    in-out property <bool> show-key: false;
    in-out property <bool> no-browser: false;
    // A sign-in in progress
    in property <bool> waiting: false;
    in property <string> device-code;
    in property <string> login-note;
    in property <string> login-detail;
    in-out property <bool> login-detail-open: false;
    in-out property <bool> code-open: false;
    in-out property <string> code-value;

    callback refresh;
    callback begin(string);
    callback close-add;
    callback search-changed(string);
    callback pick-row(string);
    callback start-login(string);
    callback cancel-login;
    callback copy-link;
    callback submit-code;
    callback add-key-now;
    callback use-next(string);
    callback toggle(string, bool);
    callback rename(string, string);
    callback move-account(string, int);
    callback reauth(string);
    callback remove(string);
    callback commit-threshold(string);
    callback open-provider(string);
    callback open-account(string);
    callback back;
    callback choose-setting(string, int);
    callback make-default;
    callback use-credit(string, string);
    callback open-history(string);
    callback close-history;
    callback add-compatible;
}

// The history of the reset credits of one account, newest first.
component HistoryDialog inherits Rectangle {
    background: #00000066;
    TouchArea { clicked => { AccountsState.close-history(); } }
    Rectangle {
        width: min(560px, root.width - 32px);
        height: min(520px, root.height - 48px);
        border-radius: 14px;
        background: Theme.composer;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000066;
        TouchArea { }
        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "リセット券の履歴"; color: Theme.fg; font-size: 16px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { glyph: Glyph.close; clicked => { AccountsState.close-history(); } }
            }
            if AccountsState.history-loading: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
            if !AccountsState.history-loading && AccountsState.history-error != "": Text { text: AccountsState.history-error; color: Theme.fg-secondary; font-size: 13px; wrap: word-wrap; }
            if !AccountsState.history-loading && AccountsState.history-error == "" && AccountsState.history.length == 0: Text { text: "記録はまだありません"; color: Theme.fg-secondary; font-size: 13px; }
            Flickable {
                content-height: hcol.preferred-height;
                hcol := VerticalLayout {
                    for h[i] in AccountsState.history: Rectangle {
                        height: hrow.preferred-height + 20px;
                        hrow := VerticalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: h.kind; color: Theme.fg; font-size: 14px; font-weight: 600; horizontal-stretch: 1; wrap: word-wrap; }
                                Text { text: h.when; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                            }
                            if h.title != "": Text { text: h.title; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                            if h.detail != "": Text { text: h.detail; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                        }
                        if i < AccountsState.history.length - 1: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Chip { label: "閉じる"; clicked => { AccountsState.close-history(); } }
            }
        }
    }
}

component AddDialog inherits Rectangle {
    background: #00000066;
    TouchArea { clicked => { AccountsState.close-add(); } }
    Rectangle {
        width: min(520px, root.width - 32px);
        height: min(dcol.preferred-height + 8px, root.height - 48px);
        border-radius: 14px;
        background: Theme.composer;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000066;
        TouchArea { }
        dcol := VerticalLayout {
            padding: 20px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                if AccountsState.add-step >= 2: IconButton { glyph: Glyph.arrow-back; clicked => { AccountsState.begin(""); } }
                Text {
                    text: AccountsState.add-step == 1 ? "アカウントを追加" : AccountsState.add-title;
                    color: Theme.fg;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton { glyph: Glyph.close; clicked => { AccountsState.close-add(); } }
            }
            if AccountsState.add-step == 1: VerticalLayout {
                spacing: 8px;
                if AccountsState.provider-id == "": Field {
                    placeholder: "プロバイダーを検索";
                    text <=> AccountsState.search;
                    edited(t) => { AccountsState.search-changed(t); }
                }
                for r in AccountsState.add-rows: Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-row;
                    background: ra.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: r.title; color: Theme.fg; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                width: kt.preferred-width + 14px;
                                border-radius: 10px;
                                background: Theme.selected;
                                kt := Text { text: r.kind; color: Theme.fg-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    ra := TouchArea { mouse-cursor: pointer; clicked => { AccountsState.pick-row(r.id); } }
                }
                if AccountsState.provider-id == "": Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-row;
                    background: fa.has-hover ? Theme.hover : transparent;
                    Text { x: 10px; text: "一覧に無いプロバイダーを追加"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                    fa := TouchArea { mouse-cursor: pointer; clicked => { AccountsState.add-step = 3; AccountsState.add-title = "OpenAI 互換のプロバイダを追加"; AccountsState.login-note = ""; } }
                }
            }
            if AccountsState.add-step == 2 && (AccountsState.add-kind == "chatgpt" || AccountsState.add-kind == "claude"): VerticalLayout {
                spacing: 8px;
                Field { placeholder: "別名(任意)"; text <=> AccountsState.add-alias; }
                if !AccountsState.waiting: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Chip {
                        label: AccountsState.add-kind == "chatgpt" ? "ChatGPT でログイン" : "Claude でログイン";
                        active: true;
                        clicked => { AccountsState.start-login("browser"); }
                    }
                    if AccountsState.add-kind == "chatgpt": Chip { label: "デバイスコードでログイン"; clicked => { AccountsState.start-login("deviceCode"); } }
                    if AccountsState.add-kind == "claude": Chip { label: "コードを貼り付けてログイン"; clicked => { AccountsState.start-login("oauthCode"); } }
                }
                if !AccountsState.waiting: HorizontalLayout {
                    spacing: 8px;
                    Switch { on <=> AccountsState.no-browser; }
                    Text { text: "ブラウザを自動で開かない"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                }
                if AccountsState.waiting: VerticalLayout {
                    spacing: 8px;
                    Text { text: "ブラウザの承認を待っています…"; color: Theme.fg; font-size: 13px; }
                    if AccountsState.device-code != "": Text { text: AccountsState.device-code; color: Theme.fg; font-size: 22px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip { label: "リンクをコピー"; clicked => { AccountsState.copy-link(); } }
                        Chip { label: "キャンセル"; clicked => { AccountsState.cancel-login(); } }
                    }
                }
                if AccountsState.code-open: VerticalLayout {
                    spacing: 6px;
                    Text { text: "リダイレクトの URL またはコードを貼り付けてください。"; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            horizontal-stretch: 1;
                            placeholder: "URL またはコード";
                            secret: !AccountsState.show-key;
                            text <=> AccountsState.code-value;
                            accepted(t) => { AccountsState.submit-code(); }
                        }
                        Chip { label: AccountsState.show-key ? "隠す" : "表示"; clicked => { AccountsState.show-key = !AccountsState.show-key; } }
                        Chip { label: "送信"; active: true; clicked => { AccountsState.submit-code(); } }
                    }
                }
                if AccountsState.login-note != "": Text { text: AccountsState.login-note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                if AccountsState.login-detail != "": HorizontalLayout {
                    alignment: start;
                    Chip { label: AccountsState.login-detail-open ? "詳細を隠す" : "詳細を表示"; clicked => { AccountsState.login-detail-open = !AccountsState.login-detail-open; } }
                }
                if AccountsState.login-detail-open && AccountsState.login-detail != "": Rectangle {
                    height: 80px;
                    border-radius: Theme.radius-row;
                    background: Theme.surface;
                    Flickable {
                        Text { x: 10px; y: 8px; width: parent.width - 20px; text: AccountsState.login-detail; color: Theme.fg-secondary; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
            if AccountsState.add-step == 3: VerticalLayout {
                spacing: 8px;
                Field { placeholder: "名前"; text <=> AccountsState.np-name; }
                Field { placeholder: "base URL(OpenAI 互換のエンドポイント)"; text <=> AccountsState.np-url; }
                Field { placeholder: "API キーの環境変数名"; text <=> AccountsState.np-env; }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        horizontal-stretch: 1;
                        placeholder: "API キーの値(環境変数名と、どちらか)";
                        secret: !AccountsState.show-key;
                        text <=> AccountsState.np-key;
                        accepted(t) => { AccountsState.add-compatible(); }
                    }
                    Chip { label: AccountsState.show-key ? "隠す" : "表示"; clicked => { AccountsState.show-key = !AccountsState.show-key; } }
                    Chip { label: "追加"; active: true; clicked => { AccountsState.add-compatible(); } }
                }
                if AccountsState.login-note != "": Text { text: AccountsState.login-note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
            }
            if AccountsState.add-step == 2 && AccountsState.add-kind.starts-with("key:"): VerticalLayout {
                spacing: 8px;
                Field { placeholder: "別名"; text <=> AccountsState.add-alias; }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        horizontal-stretch: 1;
                        placeholder: "API キー";
                        secret: !AccountsState.show-key;
                        text <=> AccountsState.add-key;
                        accepted(t) => { AccountsState.add-key-now(); }
                    }
                    Chip { label: AccountsState.show-key ? "隠す" : "表示"; clicked => { AccountsState.show-key = !AccountsState.show-key; } }
                    Chip { label: "追加"; active: true; clicked => { AccountsState.add-key-now(); } }
                }
                if AccountsState.login-note != "": Text { text: AccountsState.login-note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
}

export component AccountsView inherits Rectangle {
    Flickable {
        content-height: body.preferred-height;
        body := VerticalLayout {
            padding: 24px;
            padding-left: 40px;
            padding-right: 40px;
            spacing: 10px;
            alignment: start;
            if AccountsState.note != "": Text { text: AccountsState.note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
            if AccountsState.note-detail != "": HorizontalLayout {
                alignment: start;
                Chip { label: AccountsState.detail-open ? "詳細を隠す" : "詳細を表示"; clicked => { AccountsState.detail-open = !AccountsState.detail-open; } }
            }
            if AccountsState.detail-open && AccountsState.note-detail != "": Rectangle {
                height: 120px;
                border-radius: Theme.radius-row;
                background: Theme.composer;
                Flickable {
                    Text { x: 10px; y: 8px; width: parent.width - 20px; text: AccountsState.note-detail; color: Theme.fg-secondary; font-size: 11px; wrap: word-wrap; }
                }
            }

            // Level 1: the providers
            if AccountsState.provider-id == "" && AccountsState.unsupported: VerticalLayout {
                spacing: 10px;
                ScreenHead { title: "プロバイダー"; }
                Text { text: "サーバーが未対応です。inocode.exe を新しいビルドにしてください"; color: Theme.fg-secondary; font-size: 13px; wrap: word-wrap; }
            }
            if AccountsState.provider-id == "" && !AccountsState.unsupported: VerticalLayout {
                spacing: 10px;
                ScreenHead { title: "プロバイダー"; }
                if AccountsState.loading && AccountsState.provs.length == 0: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
                Group {
                    for p[i] in AccountsState.provs: Row {
                        label: p.name;
                        sub: p.summary;
                        bars: p.bars;
                        value: p.count >= 0 ? p.count + " アカウント" : "";
                        tone: p.tone;
                        chevron: true;
                        separator: i < AccountsState.provs.length - 1;
                        clicked => { AccountsState.open-provider(p.id); }
                    }
                }
                Group {
                    Row { label: "プロバイダを追加"; chevron: true; separator: false; clicked => { AccountsState.begin(""); } }
                }
            }

            // Level 2: the accounts of one provider
            if AccountsState.provider-id != "" && AccountsState.account-id == "": VerticalLayout {
                spacing: 10px;
                ScreenHead { title: AccountsState.provider-name; }
                if AccountsState.total.length > 0: Group {
                    Row { label: "全体の使用量"; bars: AccountsState.total; clickable: false; separator: false; }
                }
                if AccountsState.has-endpoint: VerticalLayout {
                    spacing: 0px;
                    GroupTitle { text: "接続先"; }
                    Group {
                        if AccountsState.endpoint-url != "": Row { label: "base URL"; value: AccountsState.endpoint-url; clickable: false; }
                        Row {
                            label: AccountsState.is-default ? "既定のプロバイダー" : "既定にする";
                            value: AccountsState.is-default ? "✓" : "";
                            value-color: Theme.accent;
                            clickable: !AccountsState.is-default;
                            separator: false;
                            clicked => { AccountsState.make-default(); }
                        }
                    }
                }
                if AccountsState.cards.length == 0 && !AccountsState.loading && AccountsState.pooled: Group {
                    for r[i] in AccountsState.add-rows: Row {
                        label: r.title;
                        value: r.kind;
                        chevron: true;
                        separator: i < AccountsState.add-rows.length - 1;
                        clicked => { AccountsState.pick-row(r.id); }
                    }
                }
                if AccountsState.cards.length > 0: Group {
                    for c[i] in AccountsState.cards: Row {
                        label: c.alias;
                        sub: (c.email != "" ? c.email : c.kind-label) + (c.credit-usable && c.credit-left > 0 ? " · 券 " + c.credit-left : "");
                        value: c.badge;
                        value-color: c.tone == "warn" ? Theme.warning : c.in-use ? Theme.accent : Theme.fg-secondary;
                        pct: c.bars.length > 0 ? c.bars[0].pct : -1;
                        chevron: !AccountsState.reorder;
                        separator: i < AccountsState.cards.length - 1;
                        clicked => { if !AccountsState.reorder { AccountsState.open-account(c.id); } }
                        if AccountsState.reorder: IconButton { glyph: Glyph.expand-less; box-size: 28px; icon-size: 20px; enabled: i > 0; clicked => { AccountsState.move-account(c.id, -1); } }
                        if AccountsState.reorder: IconButton { glyph: Glyph.expand-more; box-size: 28px; icon-size: 20px; enabled: i < AccountsState.cards.length - 1; clicked => { AccountsState.move-account(c.id, 1); } }
                    }
                }
                Group {
                    if AccountsState.pooled: Row { label: "アカウントを追加"; chevron: true; clicked => { AccountsState.begin(""); } }
                    if AccountsState.cards.length > 1: Row {
                        label: "並べ替え";
                        sub: "上から順に使います。";
                        clickable: false;
                        Chip { label: AccountsState.reorder ? "完了" : "並べ替える"; clicked => { AccountsState.reorder = !AccountsState.reorder; } }
                    }
                    if AccountsState.pooled && AccountsState.cards.length > 0: Row { label: "使用量を更新"; separator: false; clicked => { AccountsState.refresh(); } }
                }
                if AccountsState.settings.length > 0: VerticalLayout {
                    spacing: 0px;
                    GroupTitle { text: "設定"; }
                    Group {
                        for st[i] in AccountsState.settings: Row {
                            label: st.title;
                            sub: st.desc;
                            clickable: false;
                            separator: i < AccountsState.settings.length - 1;
                            Dropdown {
                                options: st.opts;
                                current: st.value;
                                selected(n) => { AccountsState.choose-setting(st.key, n); }
                            }
                        }
                    }
                }
                if AccountsState.cards.length > 1: Group {
                    Row {
                        label: "使用量が超える前に次のアカウントへ";
                        sub: "上のアカウントの使用量が、この値を超える前に、次のアカウントへ切り替えます。";
                        separator: false;
                        clickable: false;
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                width: 56px;
                                Field {
                                    text <=> AccountsState.threshold;
                                    accepted(t) => { AccountsState.commit-threshold(t); }
                                }
                            }
                            Text { text: "%"; color: Theme.fg-secondary; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Level 3: one account
            if AccountsState.account-id != "": VerticalLayout {
                spacing: 10px;
                ScreenHead { title: AccountsState.cur.alias; }
                Group {
                    Row {
                        label: "別名";
                        clickable: false;
                        VerticalLayout {
                            alignment: center;
                            width: 200px;
                            Field {
                                text <=> AccountsState.rename-text;
                                accepted(t) => { AccountsState.rename(AccountsState.cur.id, t); }
                            }
                        }
                    }
                    if AccountsState.cur.email != "": Row { label: "メールアドレス"; value: AccountsState.cur.email; clickable: false; }
                    if AccountsState.cur.owner != "": Row { label: "所有者"; value: AccountsState.cur.owner; clickable: false; }
                    Row { label: "プロバイダ"; value: AccountsState.provider-name; clickable: false; }
                    Row { label: "認証"; value: AccountsState.cur.plan != "" ? AccountsState.cur.kind-label + " · " + AccountsState.cur.plan : AccountsState.cur.kind-label; clickable: false; }
                    Row {
                        label: "状態";
                        sub: AccountsState.cur.recover;
                        value: AccountsState.cur.badge;
                        value-color: AccountsState.cur.tone == "warn" ? Theme.warning : AccountsState.cur.in-use ? Theme.accent : Theme.fg-secondary;
                        clickable: false;
                        separator: false;
                    }
                }
                if AccountsState.cur.bars.length > 0: Group {
                    for b[i] in AccountsState.cur.bars: Row {
                        label: b.label == "5時間" ? "5 時間の利用制限" : "週あたりの利用制限";
                        sub: b.reset;
                        value: b.pct >= 99.5 ? "上限に達しました" : Math.round(b.pct) + "%";
                        value-color: b.pct >= 99.5 ? Theme.danger : Theme.fg-secondary;
                        pct: b.pct;
                        clickable: false;
                        separator: i < AccountsState.cur.bars.length - 1;
                    }
                }
                if AccountsState.cur.credit-shown: VerticalLayout {
                    spacing: 0px;
                    Row {
                        label: "利用制限のリセット";
                        clickable: false;
                        separator: true;
                        if AccountsState.cur.credit-count > 0: Rectangle {
                            height: 24px;
                            width: cb.preferred-width + 20px;
                            border-radius: 12px;
                            background: #3fb95033;
                            cb := Text { text: AccountsState.cur.credit-count + " 回利用可能"; color: #3fb950; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if AccountsState.cur.credit-line != "": Row { label: AccountsState.cur.credit-line; clickable: false; separator: true; }
                    for g[i] in AccountsState.cur.grants: Row {
                        label: g.title;
                        sub: g.expires;
                        clickable: false;
                        separator: true;
                        ActionButton {
                            primary: true;
                            enabled: g.usable;
                            label: AccountsState.credit-confirm-id == AccountsState.cur.id + "/" + g.id ? "確認" : "リセットを使用";
                            clicked => {
                                if (AccountsState.credit-confirm-id == AccountsState.cur.id + "/" + g.id) {
                                    AccountsState.credit-confirm-id = "";
                                    AccountsState.use-credit(AccountsState.cur.id, g.id);
                                } else {
                                    AccountsState.credit-confirm-id = AccountsState.cur.id + "/" + g.id;
                                }
                            }
                        }
                    }
                    if AccountsState.credit-result != "": Row { label: AccountsState.credit-result; clickable: false; separator: true; }
                    Row { label: "履歴"; chevron: true; separator: false; clicked => { AccountsState.open-history(AccountsState.cur.id); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if !AccountsState.cur.in-use && AccountsState.cur.enabled && AccountsState.cards.length > 1: ActionButton { primary: true; label: "このアカウントを使う"; clicked => { AccountsState.use-next(AccountsState.cur.id); } }
                    ActionButton { label: AccountsState.cur.enabled ? "一時停止する" : "再開する"; clicked => { AccountsState.toggle(AccountsState.cur.id, !AccountsState.cur.enabled); } }
                    if AccountsState.cur.can-reauth: ActionButton { label: "ログインし直す"; clicked => { AccountsState.reauth(AccountsState.cur.id); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if AccountsState.confirm-id != AccountsState.cur.id: ActionButton { danger: true; label: "このアカウントを削除"; clicked => { AccountsState.confirm-id = AccountsState.cur.id; } }
                    if AccountsState.confirm-id == AccountsState.cur.id: ActionButton { danger: true; label: "削除する(ログイン情報も消えます)"; clicked => { AccountsState.remove(AccountsState.cur.id); } }
                    if AccountsState.confirm-id == AccountsState.cur.id: ActionButton { label: "やめる"; clicked => { AccountsState.confirm-id = ""; } }
                }
            }
        }
    }
    if AccountsState.add-step != 0: AddDialog { }
    if AccountsState.history-open: HistoryDialog { }
}
