import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Switch } from "widgets.slint";
import { Chip, Field } from "controls.slint";

export struct AcctBar {
    label: string,
    pct: float,
    reset: string,
}

export struct AcctCard {
    id: string,
    alias: string,
    email: string,
    owner: string,
    // "OpenAI · ChatGPT · pro"
    meta: string,
    // What is going on, in plain words ("" when nothing to say)
    status: string,
    // "ok", "warn", "danger" or "off"
    tone: string,
    in-use: bool,
    enabled: bool,
    can-reauth: bool,
    bars: [AcctBar],
}

export struct AddRow {
    // "chatgpt", "claude" or "key:<provider id>"
    id: string,
    title: string,
    kind: string,
    provider: string,
}

// The account page (src/accounts_page.rs): the accounts of the pool grouped by provider, how to
// add one (ChatGPT, Claude, API key) and the selection policy.
export global AccountsState {
    in property <[AcctCard]> cards;
    in property <bool> loading: false;
    in property <string> note;
    // The card whose "⋯" panel is open and the card asking to be deleted
    in-out property <string> open-id;
    in-out property <string> confirm-id;
    in-out property <string> rename-text;
    // The add dialog: 0 closed, 1 list, 2 form
    in-out property <int> add-step: 0;
    in-out property <string> add-kind;
    in-out property <string> add-title;
    in-out property <string> search;
    in property <[AddRow]> add-rows;
    in-out property <string> add-alias;
    in-out property <string> add-key;
    in-out property <bool> show-key: false;
    in-out property <bool> no-browser: false;
    // A sign-in in progress
    in property <bool> waiting: false;
    in property <string> device-code;
    in property <string> login-note;
    in-out property <bool> code-open: false;
    in-out property <string> code-value;
    // The order of use: open or closed, the total usage, the switching threshold
    in-out property <bool> order-open: false;
    in property <string> total;
    in-out property <string> threshold;

    callback refresh;
    callback begin(string);
    callback close-add;
    callback search-changed(string);
    callback pick-row(string);
    callback start-login(string);
    callback cancel-login;
    callback copy-link;
    callback submit-code;
    callback add-key-now;
    callback use-next(string);
    callback toggle(string, bool);
    callback rename(string, string);
    callback move-account(string, int);
    callback reauth(string);
    callback remove(string);
    callback commit-threshold(string);
    callback open-providers;
}

component Tile inherits Rectangle {
    in property <string> label;
    callback clicked;
    height: 64px;
    border-radius: Theme.radius-row + 2px;
    background: ta.has-hover ? Theme.pressed : Theme.bubble;
    Text { text: root.label; color: Theme.fg; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component UsageBar inherits VerticalLayout {
    in property <AcctBar> b;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.b.label; color: Theme.fg; font-size: 12px; horizontal-stretch: 1; }
        Text { text: root.b.pct >= 99.5 ? "上限に達しました" : Math.round(root.b.pct) + "%"; color: root.b.pct >= 99.5 ? Theme.danger : Theme.fg-secondary; font-size: 12px; }
    }
    Rectangle {
        height: 6px;
        border-radius: 3px;
        background: Theme.pressed;
        Rectangle {
            width: parent.width * max(0, min(100, root.b.pct)) / 100;
            x: 0px;
            border-radius: 3px;
            background: root.b.pct >= 99.5 ? Theme.danger : root.b.pct >= 80 ? Theme.warning : #3fb950;
        }
    }
    if root.b.reset != "": Text { text: root.b.reset; color: Theme.fg-tertiary; font-size: 11px; }
}

// Who the account is: name, then the e-mail address and the owner when known.
component Who inherits VerticalLayout {
    in property <AcctCard> c;
    spacing: 1px;
    Text { text: root.c.alias; color: Theme.fg; font-size: 14px; font-weight: 600; overflow: elide; }
    if root.c.email != "" || root.c.owner != "": Text {
        text: root.c.email != "" && root.c.owner != "" ? root.c.email + " · " + root.c.owner : root.c.email + root.c.owner;
        color: Theme.fg-secondary;
        font-size: 12px;
        overflow: elide;
    }
    Text { text: root.c.meta; color: Theme.fg-tertiary; font-size: 11px; overflow: elide; }
}

component Card inherits Rectangle {
    in property <AcctCard> c;
    height: col.preferred-height + 24px;
    border-radius: Theme.radius-row + 2px;
    background: Theme.bubble;
    col := VerticalLayout {
        padding: 12px;
        padding-left: 16px;
        padding-right: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 8px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 7px;
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: root.c.tone == "ok" ? #3fb950 : root.c.tone == "warn" || root.c.tone == "danger" ? Theme.warning : Theme.fg-tertiary;
                    }
                }
            }
            Who { c: root.c; horizontal-stretch: 1; }
            VerticalLayout {
                alignment: start;
                HorizontalLayout {
                    spacing: 4px;
                    if !root.c.in-use && root.c.enabled: Chip { label: "切り替える"; clicked => { AccountsState.use-next(root.c.id); } }
                    Chip { label: root.c.enabled ? "停止" : "再開"; clicked => { AccountsState.toggle(root.c.id, !root.c.enabled); } }
                    IconButton {
                        glyph: Glyph.more-horiz;
                        box-size: 26px;
                        icon-size: 16px;
                        selected: AccountsState.open-id == root.c.id;
                        clicked => {
                            AccountsState.confirm-id = "";
                            if AccountsState.open-id == root.c.id {
                                AccountsState.open-id = "";
                            } else {
                                AccountsState.open-id = root.c.id;
                                AccountsState.rename-text = root.c.alias;
                            }
                        }
                    }
                }
            }
        }
        if root.c.status != "": Text {
            text: root.c.status;
            color: root.c.tone == "danger" ? Theme.danger : root.c.tone == "warn" ? Theme.warning : root.c.tone == "ok" ? Theme.accent : Theme.fg-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
        for b in root.c.bars: UsageBar { b: b; }
        if AccountsState.open-id == root.c.id: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "別名"; color: Theme.fg; font-size: 12px; vertical-alignment: center; width: 70px; }
                Field { horizontal-stretch: 1; text <=> AccountsState.rename-text; accepted(t) => { AccountsState.rename(root.c.id, t); } }
                Chip { label: "保存"; clicked => { AccountsState.rename(root.c.id, AccountsState.rename-text); } }
            }
            if AccountsState.confirm-id != root.c.id: HorizontalLayout {
                spacing: 8px;
                alignment: end;
                if root.c.can-reauth: Chip { label: "ログインし直す"; clicked => { AccountsState.reauth(root.c.id); } }
                Chip { label: "削除"; clicked => { AccountsState.confirm-id = root.c.id; } }
            }
            if AccountsState.confirm-id == root.c.id: HorizontalLayout {
                spacing: 8px;
                Text { text: "このアカウントのログイン情報が削除されます。"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                Chip { label: "やめる"; clicked => { AccountsState.confirm-id = ""; } }
                Chip { label: "削除する"; active: true; clicked => { AccountsState.remove(root.c.id); } }
            }
        }
    }
}

// One row of the order of use: the account, its usage and the buttons to move it.
component OrderRow inherits Rectangle {
    in property <AcctCard> c;
    in property <int> index;
    in property <int> count;
    height: 60px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 10px;
        Text { text: root.index + 1; color: Theme.fg-tertiary; font-size: 13px; width: 18px; vertical-alignment: center; horizontal-alignment: center; }
        Who { c: root.c; horizontal-stretch: 1; alignment: center; }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            width: 130px;
            for b in root.c.bars: HorizontalLayout {
                spacing: 6px;
                Text { text: b.label; color: Theme.fg-secondary; font-size: 11px; width: 30px; vertical-alignment: center; }
                Rectangle {
                    height: 5px;
                    border-radius: 2.5px;
                    background: Theme.pressed;
                    Rectangle {
                        width: parent.width * max(0, min(100, b.pct)) / 100;
                        x: 0px;
                        border-radius: 2.5px;
                        background: b.pct >= 99.5 ? Theme.danger : b.pct >= 80 ? Theme.warning : #3fb950;
                    }
                }
                Text { text: Math.round(b.pct) + "%"; color: Theme.fg-secondary; font-size: 11px; width: 28px; horizontal-alignment: right; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            alignment: center;
            width: 40px;
            Text {
                text: root.c.tone == "danger" ? "上限" : root.c.tone == "off" ? "停止中" : root.c.in-use ? "使用中" : "";
                color: root.c.tone == "danger" ? Theme.danger : root.c.tone == "off" ? Theme.fg-tertiary : Theme.accent;
                font-size: 11px;
            }
        }
        HorizontalLayout {
            spacing: 0px;
            alignment: center;
            IconButton { glyph: Glyph.expand-less; box-size: 26px; icon-size: 18px; enabled: root.index > 0; clicked => { AccountsState.move-account(root.c.id, -1); } }
            IconButton { glyph: Glyph.expand-more; box-size: 26px; icon-size: 18px; enabled: root.index < root.count - 1; clicked => { AccountsState.move-account(root.c.id, 1); } }
        }
    }
}

component AddDialog inherits Rectangle {
    background: #00000066;
    TouchArea { clicked => { AccountsState.close-add(); } }
    Rectangle {
        width: min(520px, root.width - 32px);
        height: min(dcol.preferred-height + 8px, root.height - 48px);
        border-radius: 14px;
        background: Theme.composer;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000066;
        TouchArea { }
        dcol := VerticalLayout {
            padding: 20px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                if AccountsState.add-step == 2: IconButton { glyph: Glyph.arrow-back; clicked => { AccountsState.begin(""); } }
                Text {
                    text: AccountsState.add-step == 1 ? "アカウントを追加" : AccountsState.add-title;
                    color: Theme.fg;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton { glyph: Glyph.close; clicked => { AccountsState.close-add(); } }
            }
            if AccountsState.add-step == 1: VerticalLayout {
                spacing: 8px;
                Field {
                    placeholder: "プロバイダーを検索";
                    text <=> AccountsState.search;
                    edited(t) => { AccountsState.search-changed(t); }
                }
                for r in AccountsState.add-rows: Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-row;
                    background: ra.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { text: r.title; color: Theme.fg; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                width: kt.preferred-width + 14px;
                                border-radius: 10px;
                                background: Theme.selected;
                                kt := Text { text: r.kind; color: Theme.fg-secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }
                    ra := TouchArea { mouse-cursor: pointer; clicked => { AccountsState.pick-row(r.id); } }
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.radius-row;
                    background: fa.has-hover ? Theme.hover : transparent;
                    Text { x: 10px; text: "一覧に無いプロバイダーを追加"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                    fa := TouchArea { mouse-cursor: pointer; clicked => { AccountsState.open-providers(); } }
                }
            }
            if AccountsState.add-step == 2 && (AccountsState.add-kind == "chatgpt" || AccountsState.add-kind == "claude"): VerticalLayout {
                spacing: 8px;
                Field { placeholder: "別名(任意)"; text <=> AccountsState.add-alias; }
                if !AccountsState.waiting: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Chip {
                        label: AccountsState.add-kind == "chatgpt" ? "ChatGPT でログイン" : "Claude でログイン";
                        active: true;
                        clicked => { AccountsState.start-login("browser"); }
                    }
                    if AccountsState.add-kind == "chatgpt": Chip { label: "デバイスコードでログイン"; clicked => { AccountsState.start-login("deviceCode"); } }
                    if AccountsState.add-kind == "claude": Chip { label: "コードを貼り付けてログイン"; clicked => { AccountsState.start-login("oauthCode"); } }
                }
                if !AccountsState.waiting: HorizontalLayout {
                    spacing: 8px;
                    Switch { on <=> AccountsState.no-browser; }
                    Text { text: "ブラウザを自動で開かない"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                }
                if AccountsState.waiting: VerticalLayout {
                    spacing: 8px;
                    Text { text: "ブラウザでのログインを待っています…"; color: Theme.fg; font-size: 13px; }
                    if AccountsState.device-code != "": Text { text: AccountsState.device-code; color: Theme.fg; font-size: 22px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Chip { label: "リンクをコピー"; clicked => { AccountsState.copy-link(); } }
                        Chip { label: "キャンセル"; clicked => { AccountsState.cancel-login(); } }
                    }
                }
                if AccountsState.code-open: VerticalLayout {
                    spacing: 6px;
                    Text { text: "リダイレクトの URL またはコードを貼り付けてください。"; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            horizontal-stretch: 1;
                            placeholder: "URL またはコード";
                            secret: !AccountsState.show-key;
                            text <=> AccountsState.code-value;
                            accepted(t) => { AccountsState.submit-code(); }
                        }
                        Chip { label: AccountsState.show-key ? "隠す" : "表示"; clicked => { AccountsState.show-key = !AccountsState.show-key; } }
                        Chip { label: "送信"; active: true; clicked => { AccountsState.submit-code(); } }
                    }
                }
                if AccountsState.login-note != "": Text { text: AccountsState.login-note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
            }
            if AccountsState.add-step == 2 && AccountsState.add-kind.starts-with("key:"): VerticalLayout {
                spacing: 8px;
                Field { placeholder: "別名"; text <=> AccountsState.add-alias; }
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        horizontal-stretch: 1;
                        placeholder: "API キー";
                        secret: !AccountsState.show-key;
                        text <=> AccountsState.add-key;
                        accepted(t) => { AccountsState.add-key-now(); }
                    }
                    Chip { label: AccountsState.show-key ? "隠す" : "表示"; clicked => { AccountsState.show-key = !AccountsState.show-key; } }
                    Chip { label: "追加"; active: true; clicked => { AccountsState.add-key-now(); } }
                }
                if AccountsState.login-note != "": Text { text: AccountsState.login-note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
}

export component AccountsView inherits Rectangle {
    Flickable {
        content-height: body.preferred-height;
        body := VerticalLayout {
            padding: 24px;
            padding-left: 40px;
            padding-right: 40px;
            spacing: 10px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "アカウント"; color: Theme.fg; font-size: 20px; font-weight: 600; height: 40px; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Chip { label: "更新"; clicked => { AccountsState.refresh(); } }
                        Chip { label: "アカウントを追加"; active: true; clicked => { AccountsState.begin(""); } }
                    }
                }
            }
            if AccountsState.note != "": Text { text: AccountsState.note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
            if AccountsState.loading && AccountsState.cards.length == 0: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
            if !AccountsState.loading && AccountsState.cards.length == 0: VerticalLayout {
                spacing: 10px;
                Text { text: "アカウントがまだありません"; color: Theme.fg-secondary; font-size: 13px; }
                HorizontalLayout {
                    spacing: 10px;
                    Tile { horizontal-stretch: 1; label: "ChatGPT でログイン"; clicked => { AccountsState.begin("chatgpt"); } }
                    Tile { horizontal-stretch: 1; label: "Claude でログイン"; clicked => { AccountsState.begin("claude"); } }
                    Tile { horizontal-stretch: 1; label: "API キーを追加"; clicked => { AccountsState.begin("key"); } }
                }
            }
            // The order of use: closed it shows the total usage, open the accounts in order.
            if AccountsState.cards.length > 0: Rectangle {
                border-radius: Theme.radius-row + 2px;
                background: Theme.bubble;
                height: ocol.preferred-height;
                ocol := VerticalLayout {
                    padding: 4px;
                    Rectangle {
                        height: 56px;
                        border-radius: Theme.radius-row;
                        background: oh.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: "使う順番"; color: Theme.fg; font-size: 14px; font-weight: 600; }
                                if AccountsState.total != "": Text { text: AccountsState.total; color: Theme.fg-secondary; font-size: 12px; }
                            }
                            Icon {
                                width: 20px;
                                text: AccountsState.order-open ? Glyph.expand-less : Glyph.expand-more;
                                font-size: 20px;
                                color: Theme.fg-tertiary;
                            }
                        }
                        oh := TouchArea { mouse-cursor: pointer; clicked => { AccountsState.order-open = !AccountsState.order-open; } }
                    }
                    if AccountsState.order-open: VerticalLayout {
                        padding: 4px;
                        spacing: 2px;
                        for c[i] in AccountsState.cards: OrderRow { c: c; index: i; count: AccountsState.cards.length; }
                        HorizontalLayout {
                            height: 44px;
                            spacing: 8px;
                            padding-left: 8px;
                            Text { text: "使用量が"; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                            Field {
                                width: 64px;
                                text <=> AccountsState.threshold;
                                accepted(t) => { AccountsState.commit-threshold(t); }
                            }
                            Text { text: "% を超える前に次のアカウントへ"; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
            for c in AccountsState.cards: Card { c: c; }
        }
    }
    if AccountsState.add-step != 0: AddDialog { }
}
