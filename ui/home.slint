import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Chip, SelectChip } from "widgets.slint";
import { IntelligenceMenu, PermMenu, LocationRow, IntelligenceState, PermState, ProjectState } from "pickers.slint";
import { AppState, Message, Approval } from "state.slint";
import { MessageActions } from "chat_actions.slint";
import { ToolRow } from "chat_items.slint";
import { ShortcutState } from "shortcuts.slint";
import { MetricsState } from "metrics.slint";
import { SettingsPageState } from "settings_page.slint";
import { AccountsState } from "accounts_page.slint";
import { AttachState, AttachChips, SuggestList } from "attach.slint";
import { PromptState, QuestionCard, QueueList, ErrorBanner } from "prompts.slint";
import { MarkdownView } from "markdown.slint";
import { GitState, GitChip, GitPanel } from "git_panel.slint";

component ApprovalButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 28px;
    width: t.preferred-width + 24px;
    border-radius: Theme.radius-row;
    background: root.primary ? (ta.has-hover ? Theme.fg-secondary : Theme.fg)
        : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.selected : Theme.hover;
    t := Text {
        text: root.label;
        font-size: 13px;
        color: root.primary ? Theme.surface : Theme.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Approval request card shown above the composer.
component ApprovalCard inherits Rectangle {
    in property <Approval> item;
    // The body is open: all of it, scrolling when it is long.
    in-out property <bool> open: false;
    callback decide(string, string);
    border-radius: Theme.radius-composer;
    background: Theme.composer;
    border-width: 1px;
    border-color: Theme.border;
    height: col.preferred-height;
    col := VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Icon { width: 18px; text: Glyph.shield; font-size: 16px; color: Theme.warning; }
            Text { text: root.item.title; color: Theme.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }
        if root.item.detail != "": Text {
            text: root.item.detail;
            font-size: 12px;
            color: Theme.fg-secondary;
            wrap: word-wrap;
        }
        if root.item.lines.length > 0: Rectangle {
            border-radius: 8px;
            background: Theme.hover;
            height: body.preferred-height;
            body := VerticalLayout {
                padding: 8px;
                spacing: 4px;
                if root.item.summary != "" || root.item.long: HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.item.summary; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.item.long: Text {
                        text: root.open ? "折りたたむ" : "全部表示";
                        color: Theme.accent;
                        font-size: 12px;
                        vertical-alignment: center;
                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.open = !root.open; } }
                    }
                }
                Flickable {
                    height: min(lines.preferred-height, root.open ? 320px : 112px);
                    content-width: root.width - 44px;
                    content-height: lines.preferred-height;
                    lines := VerticalLayout {
                        // The card's width less its paddings, so that long lines wrap.
                        width: root.width - 44px;
                        for ln in root.item.lines: Text {
                            text: ln.text;
                            font-family: "Consolas";
                            font-size: 12px;
                            wrap: word-wrap;
                            font-weight: ln.kind == 3 ? 600 : 400;
                            color: ln.kind == 1 ? (Theme.dark ? #3fb950 : #1a7f37)
                                : ln.kind == 2 ? Theme.danger
                                : ln.kind == 3 ? Theme.fg
                                : ln.kind == 4 ? Theme.fg-tertiary
                                : Theme.fg-secondary;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            ApprovalButton { label: root.item.simple ? "辞退" : "拒否"; clicked => { root.decide(root.item.key, "decline"); } }
            if !root.item.simple: ApprovalButton { label: "このセッションで許可"; clicked => { root.decide(root.item.key, "session"); } }
            ApprovalButton { label: root.item.simple ? "続行" : "許可"; primary: true; clicked => { root.decide(root.item.key, "accept"); } }
        }
    }
}

// A one-line notice above the composer with up to two buttons (server not reachable, folder
// not writable).
component NoticeBar inherits Rectangle {
    in property <string> text;
    in property <string> action;
    in property <string> dismiss;
    callback acted;
    callback dismissed;
    border-radius: Theme.radius-composer;
    background: Theme.composer;
    border-width: 1px;
    border-color: Theme.border;
    height: row.preferred-height;
    row := HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        Text { text: root.text; color: Theme.fg; font-size: 12px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
        if root.action != "": ApprovalButton { label: root.action; primary: true; clicked => { root.acted(); } }
        if root.dismiss != "": ApprovalButton { label: root.dismiss; clicked => { root.dismissed(); } }
    }
}

// Round send button shown while the prompt is non-empty.
component SendButton inherits Rectangle {
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: Theme.fg;
    Icon {
        text: Glyph.arrow-upward;
        font-size: 18px;
        color: Theme.surface;
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Composer: input on top, toolbar below it (attach and permissions on the left; model,
// effort and speed, voice or send on the right), like the desktop client. The location
// and project pickers sit under the box on a new chat.
component Composer inherits VerticalLayout {
    in-out property <string> text;
    in property <string> placeholder;
    in property <IntelligenceState> intelligence;
    in property <PermState> perm;
    in property <ProjectState> project;
    in property <bool> fresh: false;
    in property <bool> busy: false;
    callback submit(string);
    callback interrupt;
    callback search-model(string);
    callback pick-effort(int);
    callback pick-model(int);
    callback pick-default;
    callback reset-model;
    callback pick-perm(int);
    callback pick-project(int);
    spacing: 8px;

    Rectangle {
        border-radius: Theme.radius-composer;
        background: Theme.composer;
        border-width: 1px;
        border-color: Theme.border;
        min-height: 84px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000012;
        drop-shadow-offset-y: 4px;

        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        FocusScope {
            capture-key-pressed(event) => {
                if (event.text == Key.Return && !event.modifiers.shift && root.text != "" && input.preedit-text == "") {
                    root.submit(root.text);
                    return accept;
                }
                // A picture on the clipboard is attached; text is pasted by the text field.
                if (event.text.to-lowercase() == "v" && event.modifiers.control && !event.modifiers.shift && AttachState.paste-image()) {
                    return accept;
                }
                // Ctrl+Shift+M opens the model picker.
                if (event.text.to-lowercase() == ShortcutState.model-key && event.modifiers.control == ShortcutState.model-ctrl
                    && event.modifiers.shift == ShortcutState.model-shift && event.modifiers.alt == ShortcutState.model-alt) {
                    picker.open();
                    return accept;
                }
                reject
            }

            VerticalLayout {
                padding: 10px;
                padding-left: 14px;
                spacing: 4px;

                if AttachState.items.length > 0: AttachChips { }
                Rectangle {
                    min-height: max(40px, input.preferred-height + 8px);
                    max-height: 240px;
                    input := TextInput {
                        y: 4px;
                        width: parent.width;
                        text <=> root.text;
                        wrap: word-wrap;
                        single-line: false;
                        color: Theme.fg;
                        font-size: Theme.body-font;
                        selection-background-color: #4d8ff566;
                        edited => { AttachState.text-changed(self.text); }
                    }
                    if root.text == "" && input.preedit-text == "": Text {
                        x: 3px;
                        y: 4px;
                        width: parent.width - 3px;
                        text: root.placeholder;
                        color: Theme.fg-tertiary;
                        font-size: Theme.body-font;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }

                HorizontalLayout {
                    height: 30px;
                    spacing: 2px;
                    plus := IconButton {
                        glyph: Glyph.add;
                        box-size: 28px;
                        icon-size: 20px;
                        y: 1px;
                        clicked => { AttachState.open-plus(self.absolute-position.x, self.absolute-position.y); }
                    }
                    PermMenu {
                        y: 1px;
                        state: root.perm;
                        pick(i) => { root.pick-perm(i); }
                    }
                    if GitState.branch != "": GitChip { y: 1px; }
                    Rectangle { horizontal-stretch: 1; }
                    picker := IntelligenceMenu {
                        y: 1px;
                        state: root.intelligence;
                        search(q) => { root.search-model(q); }
                        pick-effort(i) => { root.pick-effort(i); }
                        pick-model(i) => { root.pick-model(i); }
                        pick-default => { root.pick-default(); }
                        reset => { root.reset-model(); }
                    }
                    if root.text == "" && root.busy: Rectangle {
                        width: 28px;
                        height: 28px;
                        y: 1px;
                        border-radius: 14px;
                        background: Theme.fg;
                        Rectangle { width: 10px; height: 10px; border-radius: 2px; background: Theme.surface; }
                        TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.interrupt(); } }
                    }
                    if root.text != "": SendButton { y: 1px; clicked => { root.submit(root.text); } }
                }
            }
        }
    }

    if root.fresh: LocationRow {
        height: 28px;
        state: root.project;
        pick-project(i) => { root.pick-project(i); }
        choose-folder => { AttachState.choose-folder(); }
    }
}

component ActionRow inherits HorizontalLayout {
    in property <bool> user;
    in property <int> index;
    // The answer is shown as plain text that can be selected.
    in property <bool> selecting;
    // The last message of the conversation: only its answer can be made again.
    in property <bool> last;
    callback toggle-select;
    // Copy shows a check mark for 1.2 s, as in Claude Desktop.
    property <bool> copied: false;
    spacing: 2px;
    alignment: user ? LayoutAlignment.end : LayoutAlignment.start;
    height: 24px;
    Timer {
        interval: 1200ms;
        running: root.copied;
        triggered => { root.copied = false; }
    }
    IconButton {
        glyph: root.copied ? "\u{e5ca}" : Glyph.copy;
        box-size: 24px;
        icon-size: 14px;
        clicked => {
            root.copied = true;
            MessageActions.act("copy", root.index);
        }
    }
    if root.user: IconButton { glyph: Glyph.edit-note; box-size: 24px; icon-size: 14px; clicked => { MessageActions.act("edit", root.index); } }
    if root.user: IconButton { glyph: Glyph.replay; box-size: 24px; icon-size: 14px; clicked => { MessageActions.act("rewind", root.index); } }
    if root.last && !root.user: IconButton { glyph: "\u{e5d5}"; box-size: 24px; icon-size: 14px; clicked => { MessageActions.act("regenerate", root.index); } }
    if !root.user: IconButton { glyph: Glyph.branch; box-size: 24px; icon-size: 14px; clicked => { MessageActions.act("fork", root.index); } }
    if !root.user: IconButton { glyph: "\u{e162}"; selected: root.selecting; box-size: 24px; icon-size: 14px; clicked => { root.toggle-select(); } }
}

component ChatView inherits Rectangle {
    in property <[Message]> messages;
    public function scroll-bottom() {
        flick.content-y = min(0px, flick.height - content.preferred-height);
    }

    flick := Flickable {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: parent.width;
            padding: 16px;
            padding-top: 8px;
            spacing: 16px;
            alignment: start;
            for m[mi] in root.messages: HorizontalLayout {
                property <bool> select-mode: false;
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    max-width: Theme.composer-max-width;
                    horizontal-stretch: 1000;
                    spacing: 4px;

                    if m.role == "user": HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            max-width: 520px;
                            border-radius: Theme.radius-bubble;
                            background: Theme.bubble;
                            VerticalLayout {
                                padding: 8px;
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: m.text;
                                    wrap: word-wrap;
                                    color: Theme.fg;
                                    font-size: Theme.body-font;
                                }
                            }
                        }
                    }
                    // The answer as blocks; "select" shows the plain text, which can be selected by dragging.
                    if m.role == "assistant" && !select-mode && m.blocks.length > 0: MarkdownView { rows: m.blocks; }
                    if m.role == "assistant" && !select-mode && m.blocks.length == 0 && m.text != "": Text {
                        text: m.text;
                        wrap: word-wrap;
                        color: Theme.fg;
                        font-size: Theme.body-font;
                    }
                    if m.role == "assistant" && select-mode: TextInput {
                        text: m.text;
                        read-only: true;
                        wrap: word-wrap;
                        color: Theme.fg;
                        font-size: Theme.body-font;
                        selection-background-color: Theme.accent;
                        selection-foreground-color: #ffffff;
                    }
                    if m.role == "tool": ToolRow { text: m.text; detail: m.detail; index: mi; }
                    if m.role != "tool": ActionRow {
                        user: m.role == "user";
                        index: mi;
                        selecting: select-mode;
                        last: mi == root.messages.length - 1;
                        toggle-select => { select-mode = !select-mode; }
                    }
                    // Tokens and speed of the turn, under the last answer.
                    if mi == root.messages.length - 1 && m.role == "assistant" && MetricsState.text != "": Text {
                        text: MetricsState.text;
                        color: Theme.fg-tertiary;
                        font-size: 11px;
                        horizontal-alignment: right;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

export component Home inherits Rectangle {
    in-out property <string> prompt;
    callback submit(string);
    property <bool> chat-active: AppState.messages.length > 0;
    public function scroll-bottom() { chat.scroll-bottom(); }

    background: Theme.surface;

    // Files dragged onto the window are attached.
    DropArea {
        can-drop(event) => { DragAction.copy }
        dropped(event) => {
            AttachState.files-dropped(event.data);
            DragAction.copy
        }
    }

    VerticalLayout {
        padding-bottom: root.chat-active ? 12px : 120px;
        alignment: root.chat-active ? LayoutAlignment.stretch : LayoutAlignment.center;

        chat := ChatView {
            visible: root.chat-active;
            vertical-stretch: root.chat-active ? 1 : 0;
            messages: AppState.messages;
        }

        Rectangle {
            height: col.preferred-height;
            col := VerticalLayout {
                spacing: 28px;
                padding-left: 16px;
                padding-right: 16px;

                for a in AppState.approvals: ApprovalCard {
                    item: a;
                    max-width: Theme.composer-max-width;
                    decide(k, d) => { AppState.decide(k, d); }
                }
                if AppState.disconnected: NoticeBar {
                    max-width: Theme.composer-max-width;
                    text: "サーバーに接続できません";
                    action: "再接続";
                    acted => { AppState.reconnect(); }
                }
                if AppState.sandbox-notice != "": NoticeBar {
                    max-width: Theme.composer-max-width;
                    text: AppState.sandbox-notice;
                    action: AppState.sandbox-can-setup ? "セットアップ" : "";
                    dismiss: "閉じる";
                    acted => { AppState.sandbox-setup(); }
                    dismissed => { AppState.sandbox-dismiss(); }
                }
                if PromptState.question-open: QuestionCard { max-width: Theme.composer-max-width; }
                if PromptState.banner-level != 0: ErrorBanner { max-width: Theme.composer-max-width; }
                if PromptState.queue.length > 0: QueueList { max-width: Theme.composer-max-width; }
                if AttachState.suggestions.length > 0: SuggestList { max-width: Theme.composer-max-width; }

                if !root.chat-active: HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Text {
                        text: "こんにちは、何を作りましょうか？";
                        font-size: 30px;
                        font-weight: 400;
                        font-family: Theme.font-serif;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                }

                // Not signed in: the three ways to start (ChatGPT, API key, another provider).
                if !AppState.logged-in && !root.chat-active: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    ApprovalButton { label: "ChatGPT でログイン"; primary: true; clicked => { AccountsState.begin("chatgpt"); } }
                    ApprovalButton { label: "Claude でログイン"; clicked => { AccountsState.begin("claude"); } }
                    ApprovalButton { label: "API キーを入力"; clicked => { AccountsState.begin("key"); } }
                    ApprovalButton { label: "プロバイダを追加"; clicked => { SettingsPageState.open-providers(); } }
                }

                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    composer := Composer {
                        max-width: Theme.composer-max-width;
                        horizontal-stretch: 1000;
                        text <=> root.prompt;
                        busy: AppState.busy;
                        intelligence: AppState.intelligence;
                        perm: AppState.perm;
                        project: AppState.project;
                        fresh: !root.chat-active;
                        search-model(q) => { AppState.search-model(q); }
                        pick-effort(i) => { AppState.pick-effort(i); }
                        pick-model(i) => { AppState.pick-model(i); }
                        pick-default => { AppState.pick-default(); }
                        reset-model => { AppState.reset-model(); }
                        pick-perm(i) => { AppState.pick-perm(i); }
                        pick-project(i) => { AppState.pick-project(i); }
                        interrupt => { AppState.interrupt(); }
                        placeholder: "Enter で送信、Shift+Enter で改行";
                        submit(t) => { root.submit(t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }

    // Git of the working folder (over everything in the chat).
    GitPanel { }
}
