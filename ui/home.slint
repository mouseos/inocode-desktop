import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Chip, SelectChip } from "widgets.slint";

export struct Approval {
    key: string,
    title: string,
    detail: string,
}

export struct Message {
    id: string,
    // "user", "assistant" or "tool" (collapsed command summary row)
    role: string,
    text: string,
}

// InoCode mark: a ring with a dot, drawn as vector paths.
component Logo inherits Rectangle {
    width: 40px;
    height: 40px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        commands: "M20 4 a16 16 0 1 0 0.001 0 Z";
        stroke: Theme.brand;
        stroke-width: 3px;
        fill: transparent;
    }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.brand;
    }
}

component ApprovalButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 28px;
    width: t.preferred-width + 24px;
    border-radius: Theme.radius-row;
    background: root.primary ? (ta.has-hover ? Theme.fg-secondary : Theme.fg)
        : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.selected : Theme.hover;
    t := Text {
        text: root.label;
        font-size: 13px;
        color: root.primary ? Theme.surface : Theme.fg;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Approval request card shown above the composer.
component ApprovalCard inherits Rectangle {
    in property <Approval> item;
    callback decide(string, string);
    border-radius: Theme.radius-composer;
    background: Theme.composer;
    border-width: 1px;
    border-color: Theme.border;
    height: col.preferred-height;
    col := VerticalLayout {
        padding: 12px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Icon { width: 18px; text: Glyph.shield; font-size: 16px; color: Theme.warning; }
            Text { text: root.item.title; color: Theme.fg; font-size: 13px; font-weight: 600; vertical-alignment: center; }
        }
        if root.item.detail != "": Rectangle {
            border-radius: 8px;
            background: Theme.hover;
            VerticalLayout {
                padding: 8px;
                Text {
                    text: root.item.detail;
                    font-family: "Consolas";
                    font-size: 12px;
                    color: Theme.fg-secondary;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 96px;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: end;
            ApprovalButton { label: "拒否"; clicked => { root.decide(root.item.key, "decline"); } }
            ApprovalButton { label: "このセッションで許可"; clicked => { root.decide(root.item.key, "session"); } }
            ApprovalButton { label: "許可"; primary: true; clicked => { root.decide(root.item.key, "accept"); } }
        }
    }
}

// Round send button shown while the prompt is non-empty.
component SendButton inherits Rectangle {
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: Theme.fg;
    Icon {
        text: Glyph.arrow-upward;
        font-size: 18px;
        color: Theme.surface;
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Single-row composer pill: attach, input, voice/send. Model line sits below it.
component Composer inherits VerticalLayout {
    in-out property <string> text;
    in property <string> placeholder;
    in property <[string]> model-names;
    in property <int> model-index;
    in property <[string]> effort-names;
    in property <int> effort-index;
    in property <[string]> perm-names;
    in property <int> perm-index;
    in property <int> context-percent;
    in property <bool> daybreak-available: false;
    in property <bool> daybreak-on: false;
    in property <bool> fresh: false;
    callback pick-model(int);
    callback pick-effort(int);
    callback pick-perm(int);
    callback toggle-daybreak;
    in property <bool> busy: false;
    callback submit(string);
    callback interrupt;
    spacing: 6px;

    Rectangle {
        border-radius: Theme.radius-composer;
        background: Theme.composer;
        border-width: 1px;
        border-color: Theme.border;
        min-height: 44px;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000012;
        drop-shadow-offset-y: 4px;

        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        FocusScope {
            capture-key-pressed(event) => {
                if (event.text == Key.Return && !event.modifiers.shift && root.text != "") {
                    root.submit(root.text);
                    return accept;
                }
                reject
            }

            HorizontalLayout {
                padding: 8px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 6px;
                IconButton { glyph: Glyph.add; box-size: 28px; icon-size: 20px; y: 0px; }
                Rectangle {
                    min-height: max(28px, input.preferred-height);
                    max-height: 240px;
                    horizontal-stretch: 1;
                    input := TextInput {
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        text <=> root.text;
                        wrap: word-wrap;
                        single-line: false;
                        color: Theme.fg;
                        font-size: Theme.body-font;
                        selection-background-color: #4d8ff566;
                    }
                    if root.text == "": Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.placeholder;
                        color: Theme.fg-tertiary;
                        font-size: Theme.body-font;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
                if root.text == "" && !root.busy: IconButton { glyph: Glyph.mic; box-size: 28px; icon-size: 18px; }
                if root.text == "" && root.busy: Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.fg;
                    Rectangle { width: 10px; height: 10px; border-radius: 2px; background: Theme.surface; }
                    TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.interrupt(); } }
                }
                if root.text != "": SendButton { clicked => { root.submit(root.text); } }
            }
        }
    }

    // Model, effort, mode and context ring.
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-right: 8px;
        if root.daybreak-available && root.fresh: Rectangle {
            width: dt.preferred-width + 20px;
            height: 24px;
            border-radius: Theme.radius-row;
            background: root.daybreak-on ? Theme.selected : da.has-hover ? Theme.hover : transparent;
            dt := Text {
                text: "Daybreak " + (root.daybreak-on ? "オン" : "オフ");
                color: root.daybreak-on ? Theme.fg : Theme.fg-secondary;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            da := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.toggle-daybreak(); } }
        }
        SelectChip {
            options: root.model-names;
            current: root.model-index;
            tint: Theme.fg;
            picked(i) => { root.pick-model(i); }
        }
        SelectChip {
            options: root.effort-names;
            current: root.effort-index;
            picked(i) => { root.pick-effort(i); }
        }
        SelectChip {
            options: root.perm-names;
            current: root.perm-index;
            tint: root.perm-index == 3 ? Theme.warning : Theme.fg;
            picked(i) => { root.pick-perm(i); }
        }
        Rectangle {
            width: 14px;
            height: 14px;
            y: 5px;
            border-radius: 7px;
            border-width: 2px;
            border-color: root.context-percent > 85 ? Theme.danger : Theme.accent;
        }
    }
}

component ActionRow inherits HorizontalLayout {
    in property <bool> user;
    spacing: 2px;
    alignment: user ? LayoutAlignment.end : LayoutAlignment.start;
    height: 24px;
    if root.user: Icon { width: 18px; text: Glyph.done-all; font-size: 14px; color: Theme.fg-tertiary; }
    IconButton { glyph: Glyph.copy; box-size: 24px; icon-size: 14px; }
    if root.user: IconButton { glyph: Glyph.replay; box-size: 24px; icon-size: 14px; }
    IconButton { glyph: Glyph.share; box-size: 24px; icon-size: 14px; }
    if !root.user: IconButton { glyph: Glyph.volume; box-size: 24px; icon-size: 14px; }
}

component ChatView inherits Rectangle {
    in property <[Message]> messages;
    public function scroll-bottom() {
        flick.content-y = min(0px, flick.height - content.preferred-height);
    }

    flick := Flickable {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: parent.width;
            padding: 16px;
            padding-top: 8px;
            spacing: 16px;
            alignment: start;
            for m in root.messages: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    max-width: Theme.composer-max-width;
                    horizontal-stretch: 1000;
                    spacing: 4px;

                    if m.role == "user": HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            max-width: 520px;
                            border-radius: Theme.radius-bubble;
                            background: Theme.bubble;
                            VerticalLayout {
                                padding: 8px;
                                padding-left: 12px;
                                padding-right: 12px;
                                Text {
                                    text: m.text;
                                    wrap: word-wrap;
                                    color: Theme.fg;
                                    font-size: Theme.body-font;
                                }
                            }
                        }
                    }
                    if m.role == "assistant": Text {
                        text: m.text;
                        wrap: word-wrap;
                        color: Theme.fg;
                        font-size: Theme.body-font;
                    }
                    if m.role == "tool": HorizontalLayout {
                        spacing: 2px;
                        Text { text: m.text; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                        Icon { width: 14px; text: Glyph.chevron-right; font-size: 14px; color: Theme.fg-secondary; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if m.role != "tool": ActionRow { user: m.role == "user"; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

export component Home inherits Rectangle {
    in-out property <string> prompt;
    in property <string> project-name;
    in property <[Message]> messages;
    in property <bool> chat-active: false;
    in property <bool> busy: false;
    in property <[Approval]> approvals;
    in property <[string]> model-names;
    in property <int> model-index;
    in property <[string]> effort-names;
    in property <int> effort-index;
    in property <[string]> perm-names;
    in property <int> perm-index;
    in property <int> context-percent;
    in property <bool> daybreak-available: false;
    in property <bool> daybreak-on: false;
    callback pick-model(int);
    callback pick-effort(int);
    callback pick-perm(int);
    callback toggle-daybreak;
    callback submit(string);
    callback interrupt;
    callback decide(string, string);
    public function scroll-bottom() { chat.scroll-bottom(); }

    background: Theme.surface;

    VerticalLayout {
        padding-bottom: root.chat-active ? 12px : 120px;
        alignment: root.chat-active ? LayoutAlignment.stretch : LayoutAlignment.center;

        chat := ChatView {
            visible: root.chat-active;
            vertical-stretch: root.chat-active ? 1 : 0;
            messages: root.messages;
        }

        Rectangle {
            height: col.preferred-height;
            col := VerticalLayout {
                spacing: 28px;
                padding-left: 16px;
                padding-right: 16px;

                for a in root.approvals: ApprovalCard {
                    item: a;
                    max-width: Theme.composer-max-width;
                    decide(k, d) => { root.decide(k, d); }
                }

                if !root.chat-active: HorizontalLayout {
                    alignment: center;
                    spacing: 10px;
                    Logo { width: 28px; height: 28px; }
                    Text {
                        text: "こんにちは、何を作りましょうか？";
                        font-size: 30px;
                        font-weight: 400;
                        font-family: Theme.font-serif;
                        color: Theme.fg;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    composer := Composer {
                        max-width: Theme.composer-max-width;
                        horizontal-stretch: 1000;
                        text <=> root.prompt;
                        busy: root.busy;
                        model-names: root.model-names;
                        model-index: root.model-index;
                        effort-names: root.effort-names;
                        effort-index: root.effort-index;
                        perm-names: root.perm-names;
                        perm-index: root.perm-index;
                        context-percent: root.context-percent;
                        daybreak-available: root.daybreak-available;
                        daybreak-on: root.daybreak-on;
                        fresh: !root.chat-active;
                        pick-model(i) => { root.pick-model(i); }
                        pick-effort(i) => { root.pick-effort(i); }
                        pick-perm(i) => { root.pick-perm(i); }
                        toggle-daybreak => { root.toggle-daybreak(); }
                        interrupt => { root.interrupt(); }
                        placeholder: "Enter で送信、Shift+Enter で改行";
                        submit(t) => { root.submit(t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }
    }
}
