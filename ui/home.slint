import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Chip } from "widgets.slint";

export struct Message {
    role: string,
    text: string,
}

// InoCode mark: a ring with a dot, drawn as vector paths.
component Logo inherits Rectangle {
    width: 40px;
    height: 40px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        commands: "M20 4 a16 16 0 1 0 0.001 0 Z";
        stroke: Theme.brand;
        stroke-width: 3px;
        fill: transparent;
    }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.brand;
    }
}

component SendButton inherits Rectangle {
    in property <bool> active;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: root.active ? (ta.has-hover ? Theme.brand-strong : Theme.brand) : Theme.hover;
    Icon {
        text: Glyph.arrow-upward;
        font-size: 20px;
        color: root.active ? Theme.on-primary : Theme.fg-tertiary;
    }
    ta := TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

component Composer inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback submit(string);

    border-radius: Theme.radius-composer;
    background: Theme.composer;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 76px;
    drop-shadow-blur: 12px;
    drop-shadow-color: #0000000d;
    drop-shadow-offset-y: 2px;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    scope := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Return && !event.modifiers.shift && root.text != "") {
                root.submit(root.text);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 10px;
            padding-left: 14px;
            spacing: 2px;

            Rectangle {
                min-height: max(28px, input.preferred-height);
                max-height: 200px;
                input := TextInput {
                    width: parent.width;
                    text <=> root.text;
                    wrap: word-wrap;
                    single-line: false;
                    color: Theme.fg;
                    font-size: 15px;
                    selection-background-color: #d9775766;
                }
                if root.text == "": Text {
                    width: parent.width;
                    text: root.placeholder;
                    color: Theme.fg-tertiary;
                    font-size: 15px;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 2px;
                IconButton { glyph: Glyph.add; box-size: 32px; icon-size: 20px; }
                Rectangle { horizontal-stretch: 1; }
                Chip {
                    label: "モデル 中";
                    expandable: true;
                    height: 32px;
                }
                SendButton {
                    active: root.text != "";
                    clicked => { root.submit(root.text); }
                }
            }
        }
    }
}

component ChatView inherits Rectangle {
    in property <[Message]> messages;
    public function scroll-bottom() {
        flick.content-y = min(0px, flick.height - content.preferred-height);
    }

    flick := Flickable {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: parent.width;
            padding: 12px;
            spacing: 14px;
            alignment: start;
            for m in root.messages: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    max-width: Theme.composer-max-width;
                    horizontal-stretch: 1000;
                    HorizontalLayout {
                        if m.role == "user": Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            max-width: m.role == "user" ? 520px : Theme.composer-max-width;
                            horizontal-stretch: m.role == "user" ? 0 : 1;
                            border-radius: Theme.radius-bubble;
                            background: m.role == "user" ? Theme.bubble : transparent;
                            VerticalLayout {
                                padding: m.role == "user" ? 10px : 0px;
                                padding-left: m.role == "user" ? 14px : 0px;
                                padding-right: m.role == "user" ? 14px : 0px;
                                Text {
                                    text: m.text;
                                    wrap: word-wrap;
                                    color: Theme.fg;
                                    font-size: 15px;
                                }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

export component Home inherits Rectangle {
    in-out property <string> prompt;
    in property <string> project-name;
    in property <[Message]> messages;
    in property <bool> chat-active: false;
    in property <string> status;
    in property <bool> sidebar-open: true;
    callback submit(string);
    callback toggle-sidebar;
    public function scroll-bottom() { chat.scroll-bottom(); }

    background: Theme.surface;

    VerticalLayout {
        // Top bar: sidebar toggle (when collapsed), title and connection status.
        HorizontalLayout {
            height: Theme.titlebar-height;
            padding: 6px;
            padding-left: 8px;
            padding-right: 12px;
            spacing: 4px;
            if !root.sidebar-open: IconButton {
                glyph: Glyph.sidebar;
                clicked => { root.toggle-sidebar(); }
            }
            Text {
                text: root.chat-active ? "InoCode GUI" : "";
                color: Theme.fg;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: root.status;
                color: Theme.fg-tertiary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            padding-bottom: root.chat-active ? 12px : 96px;
            alignment: root.chat-active ? LayoutAlignment.stretch : LayoutAlignment.center;

            chat := ChatView {
                visible: root.chat-active;
                vertical-stretch: root.chat-active ? 1 : 0;
                messages: root.messages;
            }

            Rectangle {
                height: col.preferred-height;
                col := VerticalLayout {
                    spacing: 20px;
                    padding-left: 16px;
                    padding-right: 16px;

                    if !root.chat-active: HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        Logo { width: 32px; height: 32px; }
                        Text {
                            text: "こんにちは、何を作りましょうか？";
                            font-size: 30px;
                            font-family: Theme.font-serif;
                            color: Theme.fg;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        composer := Composer {
                            max-width: Theme.composer-max-width;
                            horizontal-stretch: 1000;
                            text <=> root.prompt;
                            placeholder: "InoCode にご用件をどうぞ";
                            submit(t) => { root.submit(t); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}
