import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Chip } from "widgets.slint";

export struct Message {
    role: string,
    text: string,
}

// InoCode mark: a ring with a dot, drawn as vector paths.
component Logo inherits Rectangle {
    width: 40px;
    height: 40px;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 40;
        viewbox-height: 40;
        commands: "M20 4 a16 16 0 1 0 0.001 0 Z";
        stroke: Theme.fg;
        stroke-width: 3px;
        fill: transparent;
    }
    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.fg;
    }
}

component SendButton inherits Rectangle {
    in property <bool> active;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: root.active ? Theme.fg : Theme.hover;
    Icon {
        text: Glyph.arrow-upward;
        font-size: 20px;
        color: root.active ? Theme.on-primary : Theme.fg-tertiary;
    }
    TouchArea {
        enabled: root.active;
        mouse-cursor: root.active ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

component Composer inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback submit(string);

    border-radius: Theme.radius-composer;
    background: Theme.composer;
    border-width: 1px;
    border-color: Theme.border;
    min-height: 98px;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    scope := FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Return && !event.modifiers.shift && root.text != "") {
                root.submit(root.text);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 12px;
            spacing: 4px;

            Rectangle {
                min-height: max(44px, input.preferred-height);
                max-height: 240px;
                vertical-stretch: 1;
                input := TextInput {
                    x: 4px;
                    width: parent.width - 8px;
                    text <=> root.text;
                    wrap: word-wrap;
                    single-line: false;
                    color: Theme.fg;
                    font-size: 14px;
                    selection-background-color: #339cff66;
                }
                if root.text == "": Text {
                    x: 4px;
                    width: parent.width - 8px;
                    text: root.placeholder;
                    color: Theme.fg-tertiary;
                    overflow: elide;
                    wrap: no-wrap;
                }
            }

            HorizontalLayout {
                height: 32px;
                spacing: 2px;
                IconButton { glyph: Glyph.add; box-size: 32px; icon-size: 20px; }
                Chip {
                    glyph: Glyph.shield;
                    label: "フルアクセス";
                    tint: Theme.warning;
                    height: 32px;
                }
                Rectangle { horizontal-stretch: 1; }
                Chip {
                    label: "モデル 中";
                    expandable: true;
                    height: 32px;
                }
                IconButton { glyph: Glyph.mic; box-size: 32px; icon-size: 20px; }
                SendButton {
                    active: root.text != "";
                    clicked => { root.submit(root.text); }
                }
            }
        }
    }
}

component ChatView inherits Rectangle {
    in property <[Message]> messages;
    public function scroll-bottom() {
        flick.content-y = min(0px, flick.height - content.preferred-height);
    }

    flick := Flickable {
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: parent.width;
            padding: 16px;
            spacing: 20px;
            alignment: start;
            for m in root.messages: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    max-width: Theme.composer-max-width;
                    horizontal-stretch: 1000;
                    HorizontalLayout {
                        if m.role == "user": Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            max-width: m.role == "user" ? 560px : Theme.composer-max-width;
                            horizontal-stretch: m.role == "user" ? 0 : 1;
                            border-radius: 18px;
                            background: m.role == "user" ? Theme.composer : transparent;
                            VerticalLayout {
                                padding: m.role == "user" ? 12px : 0px;
                                Text {
                                    text: m.text;
                                    wrap: word-wrap;
                                    color: Theme.fg;
                                }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

export component Home inherits Rectangle {
    in-out property <string> prompt;
    in property <string> project-name;
    in property <[Message]> messages;
    in property <bool> chat-active: false;
    in property <string> status;
    callback submit(string);
    public function scroll-bottom() { chat.scroll-bottom(); }

    background: Theme.surface;

    Text {
        x: parent.width - self.width - 16px;
        y: 14px;
        text: root.status;
        color: Theme.fg-tertiary;
        font-size: 12px;
    }

    VerticalLayout {
        padding-top: 46px;
        padding-bottom: root.chat-active ? 16px : 112px;
        alignment: root.chat-active ? LayoutAlignment.stretch : LayoutAlignment.center;

        chat := ChatView {
            visible: root.chat-active;
            vertical-stretch: root.chat-active ? 1 : 0;
            messages: root.messages;
        }

        VerticalLayout {
            spacing: 24px;
            padding-left: 16px;
            padding-right: 16px;

            if !root.chat-active: HorizontalLayout {
                alignment: center;
                Logo { }
            }

            if !root.chat-active: HorizontalLayout {
                alignment: center;
                spacing: 0px;
                if root.project-name != "": VerticalLayout {
                    Text {
                        text: root.project-name;
                        font-size: 28px;
                        color: Theme.fg;
                    }
                    Rectangle { height: 1px; background: Theme.fg-tertiary; }
                }
                Text {
                    text: root.project-name != "" ? " で何を作りますか？" : "何を作成しましょうか？";
                    font-size: 28px;
                    color: Theme.fg;
                }
            }

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                composer := Composer {
                    max-width: Theme.composer-max-width;
                    horizontal-stretch: 1000;
                    text <=> root.prompt;
                    placeholder: "Codex に何でも質問。@ でプラグインを使用、またはファイルをメンション";
                    submit(t) => { root.submit(t); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // Run location and branch, shown under the composer.
            if !root.chat-active: HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    max-width: Theme.composer-max-width;
                    horizontal-stretch: 1000;
                    height: 28px;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 2px;
                        alignment: start;
                        Chip { glyph: Glyph.computer; label: "ローカルで作業"; expandable: true; }
                        Chip { glyph: Glyph.branch; label: "main"; expandable: true; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
