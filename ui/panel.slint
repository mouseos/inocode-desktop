import { Theme } from "theme.slint";
import { PromptState } from "prompts.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Switch } from "widgets.slint";
import { PanelState } from "panel_data.slint";

component SectionTitle inherits Rectangle {
    in property <string> label;
    in property <string> trailing;
    in-out property <bool> open: true;
    height: 26px;
    HorizontalLayout {
        spacing: 2px;
        Text { text: root.label; color: Theme.fg; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        Icon {
            width: 14px;
            text: root.open ? Glyph.expand-more : Glyph.chevron-right;
            font-size: 14px;
            color: Theme.fg-tertiary;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.trailing != "": Text { text: root.trailing; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
    }
    TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
}

component PanelRow inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> label;
    in property <string> detail;
    in property <string> trailing;
    height: 26px;
    spacing: 8px;
    Icon { width: 16px; text: root.glyph; font-size: 15px; color: Theme.fg-secondary; }
    Text { text: root.label; color: Theme.fg; font-size: 12px; vertical-alignment: center; }
    if root.detail != "": Text {
        text: root.detail;
        color: Theme.fg-secondary;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
    if root.detail == "": Rectangle { horizontal-stretch: 1; }
    if root.trailing != "": Text { text: root.trailing; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
}

// Right-hand session panel: environment, context, connectors and background tasks.
export component TaskPanel inherits Rectangle {
    in property <string> folder: "ino-code";
    in property <string> cwd;
    in property <int> context-percent: 0;
    in property <string> usage-text;
    in property <string> rate-text;
    property <bool> context-open: false;
    background: Theme.surface;
    preferred-width: Theme.panel-width;
    min-width: 240px;
    max-width: 360px;
    horizontal-stretch: 0;

    Rectangle { x: 0px; width: 1px; background: Theme.border; }

    VerticalLayout {
        padding: 12px;
        padding-top: 8px;
        spacing: 2px;
        alignment: start;

        env := SectionTitle { label: "環境"; }
        if env.open: PanelRow { glyph: Glyph.computer; label: "このコンピューター"; }
        if env.open: PanelRow { glyph: Glyph.folder; label: PanelState.folder-name != "" ? PanelState.folder-name : root.folder; detail: root.cwd; }
        if env.open: HorizontalLayout {
            height: 26px;
            spacing: 8px;
            Icon { width: 16px; text: Glyph.computer; font-size: 15px; color: Theme.fg-secondary; }
            Text { text: "Remote Control"; color: Theme.fg; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
            if PanelState.remote-status == "connecting": Text { text: "接続中…"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
            if PanelState.remote-status == "errored": Text { text: "エラー"; color: Theme.danger; font-size: 12px; vertical-alignment: center; }
            Switch {
                y: 5px;
                on <=> PanelState.remote-on;
                toggled(v) => { PanelState.toggle-remote(v); }
            }
        }

        Rectangle { height: 10px; }
        Rectangle {
            height: 24px;
            TouchArea { mouse-cursor: pointer; clicked => { root.context-open = !root.context-open; } }
            HorizontalLayout {
                height: 24px;
                spacing: 6px;
                Text { text: "コンテキスト"; color: Theme.fg; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                Icon { width: 14px; text: root.context-open ? Glyph.expand-more : Glyph.chevron-right; font-size: 14px; color: Theme.fg-tertiary; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.context-percent + "%"; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; }
                Rectangle {
                    width: 26px;
                    height: 6px;
                    y: 9px;
                    border-radius: 3px;
                    background: Theme.pressed;
                    Rectangle { width: parent.width * root.context-percent / 100; border-radius: 3px; background: Theme.accent; x: 0px; }
                }
            }
        }
        if root.usage-text != "": Text { text: root.usage-text; color: Theme.fg-secondary; font-size: 11px; wrap: word-wrap; }
        if root.context-open: Rectangle {
            height: 28px;
            border-radius: Theme.radius-row;
            background: ca.has-hover ? Theme.selected : Theme.hover;
            Text {
                text: PromptState.compacting ? "圧縮中…" : "このセッションを圧縮";
                color: Theme.fg;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ca := TouchArea { enabled: !PromptState.compacting; mouse-cursor: pointer; clicked => { PromptState.compact(); } }
        }
        Rectangle { height: 6px; }
        SectionTitle { label: "使用量"; trailing: root.rate-text == "" ? "—" : root.rate-text; }
        conn := SectionTitle { label: "コネクタ"; open: false; trailing: PanelState.mcp-summary; }
        if conn.open: VerticalLayout {
            for m in PanelState.mcp: PanelRow { glyph: Glyph.extension; label: m.name; detail: m.status; }
            if PanelState.mcp.length == 0: PanelRow { glyph: Glyph.extension; label: "接続されたコネクタはありません"; }
            Rectangle {
                height: 26px;
                border-radius: Theme.radius-row;
                background: ra.has-hover ? Theme.hover : transparent;
                Text { text: "再読み込み"; color: Theme.fg-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                ra := TouchArea { mouse-cursor: pointer; clicked => { PanelState.reload-mcp(); } }
            }
        }

        Rectangle { height: 10px; }
        bg := SectionTitle { label: "バックグラウンドタスク"; trailing: PanelState.terminals.length > 0 ? PanelState.terminals.length + " 件" : ""; }
        if bg.open: VerticalLayout {
            for t in PanelState.terminals: HorizontalLayout {
                height: 26px;
                spacing: 4px;
                Icon { width: 16px; text: Glyph.terminal; font-size: 15px; color: Theme.fg-secondary; }
                Text { text: t.text; color: Theme.fg; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                IconButton { glyph: Glyph.stop; box-size: 22px; icon-size: 14px; y: 2px; clicked => { PanelState.stop-terminal(t.id); } }
            }
            if PanelState.terminals.length == 0: PanelRow { glyph: Glyph.terminal; label: "起動中のコマンドはありません"; }
            if PanelState.terminals.length > 1: Rectangle {
                height: 26px;
                border-radius: Theme.radius-row;
                background: sa.has-hover ? Theme.hover : transparent;
                Text { text: "すべて停止"; color: Theme.fg-secondary; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                sa := TouchArea { mouse-cursor: pointer; clicked => { PanelState.stop-all-terminals(); } }
            }
        }
    }
}
