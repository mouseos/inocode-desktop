import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton } from "widgets.slint";
import { Sidebar, ChatItem, ProjectItem } from "sidebar.slint";
import { Home, Message } from "home.slint";

export component AppWindow inherits Window {
    title: "InoCode";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 520px;
    min-height: 360px;
    background: Theme.surface;
    default-font-size: 14px;
    default-font-family: Theme.font-sans;

    in-out property <bool> sidebar-open: true;
    in-out property <string> prompt;
    in-out property <[Message]> messages;
    in property <string> status: "接続中…";
    callback submit(string);
    public function scroll-bottom() { home.scroll-bottom(); }

    in property <[ChatItem]> pinned: [{ title: "サンプルの固定チャット", busy: false }];
    in property <[ProjectItem]> projects: [
        { name: "ino-code", chats: [
            { title: "InoCode GUI", busy: true },
            { title: "app-server 接続の確認", busy: false },
        ] },
        { name: "sample-app", chats: [{ title: "ビルド手順の整理", busy: false }] },
        { name: "docs", chats: [] },
    ];
    in property <[ChatItem]> recent: [
        { title: "InoCode GUI", busy: true },
        { title: "app-server 接続の確認", busy: false },
        { title: "ビルド手順の整理", busy: false },
    ];

    HorizontalLayout {
        if root.sidebar-open: Sidebar {
            pinned: root.pinned;
            projects: root.projects;
            recent: root.recent;
            toggle => { root.sidebar-open = false; }
        }

        home := Home {
            horizontal-stretch: 1;
            project-name: "ino-code";
            messages: root.messages;
            chat-active: root.messages.length > 0;
            status: root.status;
            sidebar-open: root.sidebar-open;
            toggle-sidebar => { root.sidebar-open = true; }
            prompt <=> root.prompt;
            submit(t) => { root.submit(t); }
        }
    }
}
