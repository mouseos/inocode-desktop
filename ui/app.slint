import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton } from "widgets.slint";
import { Sidebar, ChatItem, ProjectItem } from "sidebar.slint";
import { Home } from "home.slint";
import { AppState } from "state.slint";
import { TaskPanel } from "panel.slint";
import { IntelligenceState, PermState, ProjectState, FullAccessDialog } from "pickers.slint";
import { DiscoveryState, SettingsDialog } from "settings.slint";
import { Tabs, TabStrip, TabHost } from "tabs.slint";
import { MenuOverlay } from "menus.slint";
import { PaletteOverlay, PaletteState } from "palette.slint";
import { PanelState } from "panel_data.slint";
import { SettingsPage, SettingsPageState } from "settings_page.slint";
import { AccountsState } from "accounts_page.slint";
import { ShortcutState } from "shortcuts.slint";
import { NavState } from "nav.slint";
import { SidebarState } from "menus.slint";

// Rust から各タブの状態へ届くように、ここで書き出す(タブを足したら 1 行足す)。
export { Tabs } from "tabs.slint";
export { AppState, Message, Approval } from "state.slint";
export { SidebarState } from "menus.slint";
export { PaletteState } from "palette.slint";
export { MessageActions } from "chat_actions.slint";
export { PromptState } from "prompts.slint";
export { PanelState } from "panel_data.slint";
export { SettingsPageState } from "settings_page.slint";
export { AccountsState } from "accounts_page.slint";
export { ShortcutState } from "shortcuts.slint";
export { NavState } from "nav.slint";
export { MetricsState } from "metrics.slint";
export { Theme } from "theme.slint";
export { AttachState } from "attach.slint";
export { KnowledgeState } from "tabs/knowledge.slint";
export { EvidenceState } from "tabs/evidence.slint";
export { TeamState } from "tabs/team.slint";
export { SettingsTabState } from "tabs/settings.slint";
export { StatsState } from "tabs/stats.slint";

export component AppWindow inherits Window {
    title: "InoCode";
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 560px;
    min-height: 360px;
    background: Theme.surface;
    default-font-size: 14px;
    default-font-family: Theme.font-sans;

    in-out property <bool> sidebar-open: true;
    in-out property <bool> panel-open: true;
    in-out property <string> prompt;
    callback submit(string);
    public function scroll-bottom() { home.scroll-bottom(); }

    // Ctrl+K opens the command palette from anywhere in the window (key events bubble up).
    FocusScope {
    key-pressed(e) => {
        if e.text.to-lowercase() == ShortcutState.palette-key && e.modifiers.control == ShortcutState.palette-ctrl
            && e.modifiers.shift == ShortcutState.palette-shift && e.modifiers.alt == ShortcutState.palette-alt {
            PaletteState.open = true;
            return accept;
        }
        if e.modifiers.control && !e.modifiers.shift && !e.modifiers.alt && e.text.to-lowercase() == "b" {
            NavState.toggle-sidebar();
            return accept;
        }
        return reject;
    }
    VerticalLayout {
        // Chrome bar: menu, sidebar toggle, history and mode switch on the left,
        // session title and panel toggles on the right.
        HorizontalLayout {
            height: Theme.chrome-height;
            Rectangle {
                width: root.sidebar-open ? Theme.sidebar-width : 160px;
                background: root.sidebar-open && Tabs.current == 0 ? Theme.sidebar : Theme.chrome;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    IconButton {
                        glyph: Glyph.menu;
                        clicked => { SidebarState.open-menu("app", "", self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                    IconButton {
                        glyph: Glyph.sidebar;
                        selected: root.sidebar-open;
                        clicked => { NavState.toggle-sidebar(); }
                    }
                    IconButton { glyph: Glyph.arrow-back; enabled: NavState.can-back; clicked => { NavState.back(); } }
                    IconButton { glyph: Glyph.arrow-forward; enabled: NavState.can-forward; clicked => { NavState.forward(); } }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 2px;
                    TabStrip { }
                    Rectangle { width: 12px; }
                    if Tabs.current == 0: Text {
                        min-width: min(self.preferred-width, 110px);
                        text: AppState.session-title;
                        color: Theme.fg;
                        font-size: 13px;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if Tabs.current == 0: IconButton {
                        glyph: Glyph.expand-more;
                        icon-size: 16px;
                        box-size: 22px;
                        clicked => { SidebarState.open-menu("head", PanelState.thread-id, self.absolute-position.x, self.absolute-position.y + self.height); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: min(st.preferred-width + 12px, 150px);
                        border-radius: Theme.radius-row;
                        background: sta.has-hover ? Theme.hover : transparent;
                        st := Text {
                            text: AppState.status + " · " + AppState.transport;
                            color: AppState.status-level == 3 ? Theme.danger
                                : AppState.status-level == 2 ? Theme.warning
                                : Theme.fg-tertiary;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        sta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { AppState.switch-transport(); }
                        }
                    }
                    Rectangle { width: 6px; }
                    if Tabs.current == 0: IconButton {
                        glyph: Glyph.list;
                        selected: root.panel-open;
                        clicked => { root.panel-open = !root.panel-open; }
                    }
                    if Tabs.current == 0: IconButton {
                        glyph: Glyph.more-horiz;
                        clicked => { SidebarState.open-menu("head-more", PanelState.thread-id, self.absolute-position.x - 180px, self.absolute-position.y + self.height); }
                    }
                }
            }
        }

        // チャットは常に生きている(タブを切り替えても、スクロールと入力が残る)。
        Rectangle {
            vertical-stretch: 1;
            HorizontalLayout {
                width: parent.width;
                height: parent.height;
                visible: Tabs.current == 0;
                if root.sidebar-open: Sidebar {
                    projects: AppState.projects;
                    user-name: AppState.account-label;
                    logged-in: AppState.logged-in;
                    login => { AccountsState.begin("chatgpt"); }
                    open-settings => { SettingsPageState.open-page(); }
                    new-chat-in(cwd) => { AppState.new-chat-in(cwd); }
                    new-chat => { AppState.new-chat(); }
                    open-thread(id) => { AppState.open-thread(id); }
                }
                home := Home {
                    horizontal-stretch: 1;
                    prompt <=> root.prompt;
                    submit(t) => { root.submit(t); }
                }
                if root.panel-open: TaskPanel {
                    cwd: AppState.cwd-text;
                    context-percent: AppState.context-percent;
                    usage-text: AppState.usage-text;
                    rate-text: AppState.rate-text;
                }
            }
            if Tabs.current != 0: TabHost {
                width: parent.width;
                height: parent.height;
            }
        }
    }

    }

    if AppState.settings-open: SettingsDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        discovery: AppState.discovery;
        close => { AppState.settings-open = false; }
        toggle-enabled => { AppState.toggle-discovery(); }
        headroom-up => { AppState.headroom-up(); }
        headroom-down => { AppState.headroom-down(); }
        run-now => { AppState.run-discovery(); }
    }

    if AppState.full-confirm-open: FullAccessDialog {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        confirm => { AppState.confirm-full(); }
        cancel => { AppState.cancel-full(); }
    }

    SettingsPage {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }

    PaletteOverlay {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }

    MenuOverlay {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
    }
}
