// Hover actions under a chat message (copy, edit, rewind, fork). Rust: src/chat_actions.rs.
export global MessageActions {
    // kind: "copy", "edit", "rewind" or "fork"; the index is the row in AppState.messages.
    callback act(string, int);
    // Reply to the selected part of a message: the row, and the start and end of the selection
    // (bytes of the message text).
    callback reply-selection(int, int, int);
}
