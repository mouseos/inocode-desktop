import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, NavRow } from "widgets.slint";

export struct ChatItem {
    title: string,
    // 0 none, 1 working, 2 unread, 3 error
    status: int,
    selected: bool,
    // 0 = session, 1 = child session (tree line)
    depth: int,
}

export struct ProjectItem {
    name: string,
    chats: [ChatItem],
}

component GroupHeader inherits Rectangle {
    in property <string> label;
    in-out property <bool> open: true;
    callback add;
    height: 28px;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.fg-secondary;
            font-size: Theme.group-font;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            width: 14px;
            text: root.open ? Glyph.expand-more : Glyph.chevron-right;
            font-size: 14px;
            color: Theme.fg-tertiary;
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton { glyph: Glyph.swap-vert; icon-size: 15px; y: 2px; }
        IconButton { glyph: Glyph.add; icon-size: 17px; y: 2px; clicked => { root.add(); } }
    }
}

component ProjectGroup inherits VerticalLayout {
    in property <ProjectItem> project;
    property <bool> open: true;
    spacing: Theme.stack-gap;
    GroupHeader {
        label: root.project.name;
        open <=> root.open;
    }
    if root.open: VerticalLayout {
        spacing: Theme.stack-gap;
        for chat in root.project.chats: NavRow {
            label: chat.title;
            status: chat.status;
            selected: chat.selected;
            tree: chat.depth > 0;
            indent: chat.depth > 0 ? 8px : 0px;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ProjectItem]> projects;
    in property <string> user-name: "ローカル";
    callback new-chat;

    background: Theme.sidebar;
    preferred-width: Theme.sidebar-width;
    min-width: 220px;
    max-width: 380px;
    horizontal-stretch: 0;

    VerticalLayout {
        padding: 8px;
        padding-top: 4px;
        padding-bottom: 0px;
        spacing: Theme.stack-gap;

        NavRow { glyph: Glyph.add; label: "新規作成"; clicked => { root.new-chat(); } }
        NavRow { glyph: Glyph.search; label: "検索"; }
        NavRow { glyph: Glyph.category; label: "Artifacts"; action-glyph: Glyph.add; }
        NavRow { glyph: Glyph.work; label: "カスタマイズ"; }
        NavRow { glyph: Glyph.more-horiz; label: "その他"; }

        Rectangle { height: 8px; }

        Flickable {
            content-height: content.preferred-height;
            content := VerticalLayout {
                width: parent.width;
                spacing: 10px;
                alignment: start;
                for project in root.projects: ProjectGroup { project: project; }
            }
        }

        // Footer: account menu and settings.
        HorizontalLayout {
            height: 44px;
            padding-top: 6px;
            padding-bottom: 6px;
            padding-left: 6px;
            spacing: 6px;
            Rectangle {
                width: 22px;
                height: 22px;
                y: 1px;
                border-radius: 11px;
                background: Theme.pressed;
                Text { text: "I"; color: Theme.fg-secondary; font-size: 11px; }
            }
            Text {
                text: root.user-name;
                color: Theme.fg;
                font-size: Theme.row-font;
                font-weight: 500;
                vertical-alignment: center;
            }
            Icon { width: 14px; text: Glyph.expand-more; font-size: 14px; color: Theme.fg-tertiary; }
            Rectangle { horizontal-stretch: 1; }
            IconButton { glyph: Glyph.settings; icon-size: 18px; }
        }
    }
}
