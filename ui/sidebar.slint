import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, NavRow } from "widgets.slint";
import { SidebarState } from "menus.slint";
import { PaletteState } from "palette.slint";

export struct ChatItem {
    id: string,
    title: string,
    // 0 none, 1 working, 2 unread, 3 error, 4 needs you
    status: int,
    selected: bool,
    // 0 = session, 1 = child session (tree line)
    depth: int,
}

export struct ProjectItem {
    name: string,
    cwd: string,
    chats: [ChatItem],
    // The "Pinned" group at the top: no new-session button.
    pinned: bool,
}

component GroupHeader inherits Rectangle {
    in property <string> label;
    in property <bool> pinned: false;
    in-out property <bool> open: true;
    callback add;
    height: 28px;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open = !root.open; }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.fg-secondary;
            font-size: Theme.group-font;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            width: 14px;
            text: root.open ? Glyph.expand-more : Glyph.chevron-right;
            font-size: 14px;
            color: Theme.fg-tertiary;
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.pinned: sortbtn := IconButton {
            glyph: Glyph.swap-vert;
            icon-size: 15px;
            y: 2px;
            clicked => { SidebarState.open-menu("sort", "", self.absolute-position.x, self.absolute-position.y + self.height); }
        }
        if !root.pinned: IconButton { glyph: Glyph.add; icon-size: 17px; y: 2px; clicked => { root.add(); } }
    }
}

component ProjectGroup inherits VerticalLayout {
    in property <ProjectItem> project;
    callback open-thread(string);
    callback new-in(string);
    property <bool> open: true;
    spacing: Theme.stack-gap;
    GroupHeader {
        label: root.project.name;
        pinned: root.project.pinned;
        open <=> root.open;
        add => { root.new-in(root.project.cwd); }
    }
    if root.open: VerticalLayout {
        spacing: Theme.stack-gap;
        for chat in root.project.chats: NavRow {
            label: chat.title;
            status: chat.status;
            selected: chat.selected;
            tree: chat.depth > 0;
            indent: chat.depth > 0 ? 8px : 0px;
            has-menu: true;
            editing: SidebarState.rename-id == chat.id;
            edit-text: chat.title;
            clicked => { root.open-thread(chat.id); }
            menu(x, y) => { SidebarState.open-menu("thread", chat.id, x, y); }
            edit-accepted(t) => { SidebarState.commit-rename(chat.id, t); }
            edit-cancelled => { SidebarState.rename-id = ""; }
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ProjectItem]> projects;
    in property <string> user-name: "ローカル";
    in property <bool> logged-in: true;
    callback new-chat;
    callback new-chat-in(string);
    callback open-thread(string);
    callback login;
    callback open-settings;

    background: Theme.sidebar;
    preferred-width: Theme.sidebar-width;
    min-width: 220px;
    max-width: 380px;
    horizontal-stretch: 0;

    VerticalLayout {
        padding: 8px;
        padding-top: 4px;
        padding-bottom: 0px;
        spacing: Theme.stack-gap;

        NavRow { glyph: Glyph.add; label: "新規作成"; clicked => { root.new-chat(); } }
        NavRow { glyph: Glyph.search; label: "検索"; clicked => { PaletteState.open = true; } }
        more := NavRow {
            glyph: Glyph.more-horiz;
            label: "その他";
            clicked => { SidebarState.open-menu("more", "", self.absolute-position.x, self.absolute-position.y + self.height); }
        }

        Rectangle { height: 8px; }

        Flickable {
            content-height: content.preferred-height;
            content := VerticalLayout {
                width: parent.width;
                spacing: 10px;
                alignment: start;
                if root.projects.length == 0: Text {
                    text: "セッションはありません";
                    color: Theme.fg-tertiary;
                    font-size: Theme.row-font;
                    horizontal-alignment: center;
                    height: 40px;
                }
                for project in root.projects: ProjectGroup {
                    project: project;
                    open-thread(id) => { root.open-thread(id); }
                    new-in(cwd) => { root.new-chat-in(cwd); }
                }
                if SidebarState.has-more: NavRow {
                    label: "さらに表示";
                    clicked => { SidebarState.load-more(); }
                }
            }
        }

        // Footer: account menu and settings.
        Rectangle {
            height: 44px;
            acct := TouchArea {
                x: 0px;
                width: 200px;
                mouse-cursor: pointer;
                clicked => { SidebarState.open-menu("account", "", self.absolute-position.x + 6px, self.absolute-position.y); }
            }
        HorizontalLayout {
            height: 44px;
            padding-top: 6px;
            padding-bottom: 6px;
            padding-left: 6px;
            spacing: 6px;
            VerticalLayout {
                width: 22px;
                alignment: center;
                Rectangle {
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.pressed;
                    Text { text: SidebarState.account-initial; color: Theme.fg-secondary; font-size: 11px; }
                }
            }
            Text {
                text: root.user-name;
                color: root.logged-in ? Theme.fg : Theme.warning;
                font-size: Theme.row-font;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 0;
                max-width: 150px;
            }
            Icon { width: 14px; text: Glyph.expand-more; font-size: 14px; color: Theme.fg-tertiary; }
            Rectangle { horizontal-stretch: 1; }
            if !root.logged-in: Rectangle {
                width: lt.preferred-width + 20px;
                height: 24px;
                y: 1px;
                border-radius: Theme.radius-row;
                background: la.has-hover ? Theme.pressed : Theme.selected;
                lt := Text { text: "ログイン"; color: Theme.fg; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                la := TouchArea { mouse-cursor: pointer; clicked => { root.login(); } }
            }
            IconButton { glyph: Glyph.settings; icon-size: 18px; clicked => { root.open-settings(); } }
        }
        }
    }
}
