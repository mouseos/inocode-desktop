import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, NavRow } from "widgets.slint";

export struct ChatItem {
    title: string,
    busy: bool,
}

export struct ProjectItem {
    name: string,
    chats: [ChatItem],
}

component SectionHeader inherits HorizontalLayout {
    in property <string> label;
    in property <string> action-glyph;
    callback action;
    height: 26px;
    padding-left: 8px;
    padding-right: 2px;
    padding-top: 8px;
    padding-bottom: 0px;
    Text {
        text: root.label;
        color: Theme.fg-tertiary;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
    if root.action-glyph != "": IconButton {
        glyph: root.action-glyph;
        box-size: 24px;
        icon-size: 16px;
        clicked => { root.action(); }
    }
}

component ProjectGroup inherits VerticalLayout {
    in property <ProjectItem> project;
    property <bool> open: true;
    NavRow {
        glyph: root.open ? Glyph.folder-open : Glyph.folder;
        label: root.project.name;
        clicked => { root.open = !root.open; }
    }
    if root.open && root.project.chats.length == 0: Text {
        text: "チャットはありません";
        color: Theme.fg-tertiary;
        height: Theme.row-height;
        vertical-alignment: center;
        x: 32px;
    }
    if root.open: VerticalLayout {
        for chat in root.project.chats: NavRow {
            label: chat.title;
            indent: 20px;
            busy: chat.busy;
        }
    }
}

export component Sidebar inherits Rectangle {
    in property <[ChatItem]> pinned;
    in property <[ProjectItem]> projects;
    in property <[ChatItem]> recent;
    callback new-chat;
    callback toggle;

    background: Theme.sidebar;
    preferred-width: Theme.sidebar-width;
    min-width: 200px;
    max-width: 340px;
    horizontal-stretch: 0;

    VerticalLayout {
        padding: 6px;
        spacing: 1px;

        HorizontalLayout {
            height: 36px;
            padding-left: 4px;
            spacing: 2px;
            IconButton { glyph: Glyph.sidebar; clicked => { root.toggle(); } }
            Text {
                text: "InoCode";
                color: Theme.fg;
                font-family: Theme.font-serif;
                font-size: 17px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton { glyph: Glyph.search; }
        }

        NavRow {
            glyph: Glyph.edit-note;
            label: "新しいチャット";
            accent: true;
            clicked => { root.new-chat(); }
        }

        Flickable {
            content-height: content.preferred-height;
            content := VerticalLayout {
                width: parent.width;
                spacing: 1px;
                alignment: start;

                if root.pinned.length > 0: SectionHeader { label: "ピン留め"; }
                for chat in root.pinned: NavRow {
                    glyph: Glyph.push-pin;
                    label: chat.title;
                }

                SectionHeader { label: "プロジェクト"; action-glyph: Glyph.add; }
                for project in root.projects: ProjectGroup { project: project; }

                SectionHeader { label: "最近"; }
                for chat in root.recent: NavRow {
                    label: chat.title;
                    busy: chat.busy;
                }
            }
        }

        // Footer: account row.
        HorizontalLayout {
            height: 44px;
            padding: 4px;
            spacing: 8px;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: Theme.bubble;
                Text { text: "I"; color: Theme.fg-secondary; font-size: 13px; }
            }
            Text {
                text: "ローカル";
                color: Theme.fg-secondary;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }
}
