import { Palette } from "std-widgets.slint";

// Tokens sampled from the Claude Desktop frame (ion-dist --cds-* / --df-*) and from a
// capture of the running app (dark: page #191919, sidebar #1f1f1f, composer #303030,
// user bubble #252525). The scheme follows the operating system.
export global Theme {
    // 0 follow the system, 1 light, 2 dark (settings page)
    in-out property <int> scheme: 0;
    out property <bool> dark: scheme == 2 || (scheme == 0 && Palette.color-scheme != ColorScheme.light);
    out property <color> surface: dark ? #191919 : #ffffff;
    out property <color> sidebar: dark ? #1f1f1f : #f6f6f5;
    out property <color> chrome: dark ? #202020 : #f6f6f5;
    out property <color> fg: dark ? #ffffffed : #000000e6;
    out property <color> fg-secondary: dark ? #ffffff91 : #00000099;
    out property <color> fg-tertiary: dark ? #ffffff66 : #00000077;
    out property <color> border: dark ? #ffffff14 : #00000014;
    out property <color> hover: dark ? #ffffff13 : #0000000d;
    out property <color> pressed: dark ? #ffffff26 : #0000001a;
    out property <color> selected: dark ? #ffffff1a : #00000012;
    out property <color> composer: dark ? #303030 : #ffffff;
    out property <color> bubble: dark ? #252525 : #f0efed;
    out property <color> warning: dark ? #e0a41a : #8f5a0e;
    out property <color> danger: dark ? #ff5a5f : #cd2054;
    out property <color> brand: #d97757;
    out property <color> accent: dark ? #4d8ff5 : #2c84db;
    out property <color> on-primary: #ffffff;
    out property <length> radius-row: 6px;
    out property <length> radius-composer: 14px;
    out property <length> radius-bubble: 12px;
    out property <length> row-height: 26px;
    out property <length> row-font: 13px;
    out property <length> group-font: 12px;
    out property <length> icon-size: 16px;
    out property <length> leading-slot: 24px;
    out property <length> row-gap: 4px;
    out property <length> stack-gap: 2px;
    out property <length> chrome-height: 36px;
    out property <length> sidebar-width: 288px;
    out property <length> panel-width: 288px;
    out property <length> composer-max-width: 672px;
    out property <length> body-font: 14px;
    out property <string> font-sans: "Segoe UI";
    out property <string> font-serif: "Georgia";
}
