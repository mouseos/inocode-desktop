// Design tokens. Values follow the dark theme of the Codex Desktop web assets
// (gray scale, alpha overlays, 14px base text). Sidebar colour approximates
// the translucent "surface-under" material with a solid colour.
export global Theme {
    out property <color> surface: #181818;
    out property <color> sidebar: #111111;
    out property <color> fg: #dfdfdf;
    out property <color> fg-secondary: #dfdfdfb3;
    out property <color> fg-tertiary: #dfdfdf80;
    out property <color> border: #ffffff1f;
    out property <color> hover: #ffffff14;
    out property <color> pressed: #ffffff1f;
    out property <color> composer: #262626;
    out property <color> warning: #ff8549;
    out property <color> accent: #339cff;
    out property <color> on-primary: #0d0d0d;
    out property <length> radius-row: 8px;
    out property <length> radius-composer: 22px;
    out property <length> row-height: 32px;
    out property <length> titlebar-height: 36px;
    out property <length> composer-max-width: 768px;
}
