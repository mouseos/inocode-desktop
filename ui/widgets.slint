import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> icon-size: 18px;
    in property <length> box-size: 28px;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.fg-secondary;
    callback clicked;

    width: root.box-size;
    height: root.box-size;
    border-radius: Theme.radius-row;
    background: !root.enabled ? transparent
        : ta.pressed ? Theme.pressed
        : (ta.has-hover || root.selected) ? Theme.hover : transparent;

    Icon {
        text: root.glyph;
        font-size: root.icon-size;
        color: root.enabled ? root.tint : Theme.fg-tertiary;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected: false;
    in property <length> indent: 0px;
    in property <bool> busy: false;
    callback clicked;

    height: Theme.row-height;
    border-radius: Theme.radius-row;
    background: ta.pressed ? Theme.pressed
        : (ta.has-hover || root.selected) ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 8px + root.indent;
        padding-right: 8px;
        spacing: 8px;
        if root.glyph != "": Icon {
            width: 20px;
            text: root.glyph;
            font-size: 18px;
        }
        Text {
            text: root.label;
            color: Theme.fg;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            horizontal-stretch: 1;
        }
        if root.busy: Icon {
            width: 16px;
            text: "\u{e627}";
            font-size: 14px;
            color: Theme.fg-tertiary;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Chip inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <color> tint: Theme.fg-secondary;
    in property <bool> expandable: false;
    callback clicked;

    height: 28px;
    border-radius: Theme.radius-row;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: root.expandable ? 4px : 8px;
        spacing: 4px;
        alignment: center;
        if root.glyph != "": Icon {
            width: 18px;
            text: root.glyph;
            font-size: 16px;
            color: root.tint;
        }
        Text {
            text: root.label;
            color: root.tint;
            font-size: 13px;
            vertical-alignment: center;
        }
        if root.expandable: Icon {
            width: 16px;
            text: "\u{e5cf}";
            font-size: 16px;
            color: root.tint;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
