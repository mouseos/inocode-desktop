import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";

export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> icon-size: Theme.icon-size;
    in property <length> box-size: 24px;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.fg-secondary;
    callback clicked;

    width: root.box-size;
    height: root.box-size;
    border-radius: Theme.radius-row;
    background: !root.enabled ? transparent
        : ta.pressed ? Theme.pressed
        : (ta.has-hover || root.selected) ? Theme.selected : transparent;

    Icon {
        text: root.glyph;
        font-size: root.icon-size;
        color: !root.enabled ? Theme.fg-tertiary : root.selected ? Theme.fg : root.tint;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Status marker at the end of a session row.
// kind: 0 none, 1 working, 2 unread (blue dot), 3 error, 4 needs you (yellow dot)
export component StatusMark inherits Rectangle {
    in property <int> kind;
    width: root.kind == 0 ? 0px : 16px;
    height: 16px;
    if root.kind == 1: Icon { text: Glyph.sync; font-size: 13px; color: Theme.fg-tertiary; }
    if root.kind == 2: Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
    if root.kind == 3: Icon { text: Glyph.error; font-size: 14px; color: Theme.danger; }
    if root.kind == 4: Rectangle {
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.warning;
    }
}

export component NavRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> action-glyph;
    in property <bool> selected: false;
    in property <length> indent: 0px;
    in property <int> status: 0;
    in property <bool> tree: false;
    // A session row: the "…" button shows on hover and the right click opens the same menu.
    in property <bool> has-menu: false;
    in property <bool> editing: false;
    in-out property <string> edit-text;
    callback clicked;
    callback action;
    // Window position for the popup menu.
    callback menu(length, length);
    callback edit-accepted(string);
    callback edit-cancelled;

    height: Theme.row-height;
    border-radius: Theme.radius-row;
    background: ta.pressed ? Theme.pressed
        : root.selected ? Theme.selected
        : ta.has-hover ? Theme.hover : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if root.has-menu && e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 4px + root.indent;
        padding-right: 4px;
        spacing: Theme.row-gap;
        if root.tree: Rectangle {
            width: 12px;
            Path {
                x: 2px;
                y: 0px;
                width: 10px;
                height: parent.height / 2 + 1px;
                viewbox-width: 10;
                viewbox-height: 14;
                commands: "M0 0 L0 9 Q0 13 4 13 L10 13";
                stroke: Theme.fg-tertiary;
                stroke-width: 1px;
                fill: transparent;
            }
        }
        if root.glyph != "": Icon {
            width: Theme.leading-slot;
            text: root.glyph;
            font-size: Theme.icon-size;
            color: Theme.fg;
        }
        if root.glyph == "" && !root.tree: Rectangle { width: 4px; }
        if root.editing: Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: Theme.composer;
            border-width: 1px;
            border-color: Theme.accent;
            ti := TextInput {
                x: 4px;
                width: parent.width - 8px;
                text <=> root.edit-text;
                font-size: Theme.row-font;
                color: Theme.fg;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.edit-accepted(self.text); }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.edit-cancelled();
                        return accept;
                    }
                    return reject;
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.edit-accepted(self.text);
                    }
                }
                init => {
                    self.focus();
                    self.select-all();
                }
            }
        }
        if !root.editing: Text {
            text: root.label;
            color: Theme.fg;
            font-size: Theme.row-font;
            vertical-alignment: center;
            overflow: elide;
            min-width: 0px;
            horizontal-stretch: 1;
        }
        if !root.editing: StatusMark { kind: root.status; }
        if !root.editing && (root.has-menu ? (root.selected || ta.has-hover) : (ta.has-hover && root.action-glyph != "")): btn := IconButton {
            glyph: root.action-glyph != "" ? root.action-glyph : Glyph.more-horiz;
            box-size: 20px;
            icon-size: 14px;
            y: (parent.height - self.height) / 2;
            clicked => {
                if root.has-menu {
                    root.menu(self.absolute-position.x, self.absolute-position.y + self.height);
                } else {
                    root.action();
                }
            }
        }
        if !root.editing && !root.has-menu && !ta.has-hover && root.action-glyph != "": Rectangle { width: 20px; }
    }
}

export component Chip inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <color> tint: Theme.fg-secondary;
    in property <bool> expandable: false;
    callback clicked;

    height: 24px;
    border-radius: Theme.radius-row;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: root.expandable ? 2px : 6px;
        spacing: 3px;
        alignment: center;
        if root.glyph != "": Icon {
            width: 16px;
            text: root.glyph;
            font-size: 14px;
            color: root.tint;
        }
        Text {
            text: root.label;
            color: root.tint;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.expandable: Icon {
            width: 14px;
            text: Glyph.expand-more;
            font-size: 14px;
            color: root.tint;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Compact drop-up selector: shows the current option and opens a list above it.
export component SelectChip inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <string> prefix;
    in property <bool> enabled: true;
    in property <color> tint: Theme.fg-secondary;
    callback picked(int);

    property <string> label: root.current >= 0 && root.current < root.options.length
        ? root.options[root.current] : "—";

    height: 24px;
    width: t.preferred-width + 26px;
    border-radius: Theme.radius-row;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 2px;
        t := Text {
            text: root.prefix + root.label;
            color: root.enabled ? root.tint : Theme.fg-tertiary;
            font-size: 12px;
            vertical-alignment: center;
        }
        Icon { width: 14px; text: Glyph.expand-more; font-size: 14px; color: Theme.fg-tertiary; }
    }
    ta := TouchArea {
        enabled: root.enabled && root.options.length > 0;
        mouse-cursor: pointer;
        clicked => { pop.show(); }
    }
    pop := PopupWindow {
        x: 0px;
        y: -(root.options.length * 28px + 10px);
        width: 220px;
        Rectangle {
            border-radius: 10px;
            background: Theme.composer;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000033;
            VerticalLayout {
                padding: 4px;
                for o[i] in root.options: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: oa.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: o;
                            color: Theme.fg;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if i == root.current: Icon { width: 14px; text: "\u{e5ca}"; font-size: 14px; color: Theme.fg; }
                    }
                    oa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.picked(i); }
                    }
                }
            }
        }
    }
}

export component Switch inherits Rectangle {
    in-out property <bool> on: true;
    width: 28px;
    height: 16px;
    border-radius: 8px;
    background: root.on ? Theme.accent : Theme.pressed;
    Rectangle {
        x: root.on ? parent.width - self.width - 2px : 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: #ffffff;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.on = !root.on; }
    }
}
