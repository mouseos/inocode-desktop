import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Switch } from "widgets.slint";
import { InocodePage } from "tabs/settings.slint";
import { StatsPage } from "tabs/stats.slint";
import { Chip, Field } from "controls.slint";
import { Group, GroupTitle, Row, ScreenHead, Dropdown, Segmented } from "setting_rows.slint";
import { AccountsView } from "accounts_page.slint";

export struct NavItem {
    label: string,
    // A group heading (not clickable)
    heading: bool,
    // Where the item is in the list of all the sections
    index: int,
    glyph: string,
}

export struct UsageBar {
    label: string,
    pct: float,
    reset: string,
}

export struct UsageAccount {
    // Human name of the provider (OpenAI, Claude); the cards are grouped by it.
    provider: string,
    alias: string,
    email: string,
    plan: string,
    in-use: bool,
    bars: [UsageBar],
    credits: string,
    banked: string,
}

export struct SRow {
    id: string,
    title: string,
    desc: string,
    value: string,
    // 0 text, 1 switch, 2 button (label = value), 3 choice in a dropdown (opts, current = value), 4 shortcut,
    // 5 text input, 6 heading of the next group, 7 choice among a few, side by side
    kind: int,
    on: bool,
    opts: [string],
    // The index of the current choice in opts (kind 3)
    cur: int,
}

// A group of rows: a heading row (kind 6) starts the next one.
export struct SGroup {
    title: string,
    rows: [SRow],
}

// The one settings page (gear and account menu), src/settings_page.rs.
// `layout` picks what the right side shows: 0 rows, 1 InoCode, 2 account pool, 3 providers, 4 personalization, 5 usage, 6 sign-in.
export global SettingsPageState {
    in-out property <bool> open: false;
    in-out property <int> section: 0;
    in property <int> layout: 0;
    in property <[NavItem]> sections;
    // The text of the search field above the list of sections
    in-out property <string> nav-search;
    in property <[SGroup]> groups;
    in property <[UsageAccount]> usage;
    in property <string> title;
    in property <[SRow]> rows;
    in property <bool> loading: false;
    // The shortcut being recorded ("" when none).
    in-out property <string> recording-id;
    in property <string> plan;
    // Sign-in
    in-out property <string> key-alias;
    in-out property <string> key-value;
    in-out property <bool> show-key: false;
    in property <string> login-note;
    // Sign-in: the providers the server knows, the chosen one and what it offers
    in property <[string]> providers;
    in property <int> provider: 0;
    in property <bool> can-chatgpt: true;
    in property <bool> can-claude: false;
    in property <bool> can-key: true;
    // The code Anthropic shows after a browser sign-in (code#state)
    in-out property <bool> code-open: false;
    in-out property <string> code-value;
    // New model provider
    in-out property <string> prov-name;
    in-out property <string> prov-url;
    in-out property <string> prov-env;
    in-out property <string> prov-key;
    // AGENTS.md
    in-out property <string> raw-text;
    in property <string> raw-note;
    // The transport of the connection (stdio or WS)
    in property <string> transport;

    callback open-page;
    callback nav-search-changed(string);
    callback open-section(int);
    callback open-providers;
    callback open-signin;
    callback select(int);
    callback row-action(string);
    callback row-toggle(string, bool);
    callback row-choose(string, int);
    callback row-text(string, string);
    // id, lower-case key text, ctrl, shift, alt
    callback record(string, string, bool, bool, bool);
    callback login-chatgpt;
    callback pick-provider(int);
    // method: "browser" or "oauthCode"
    callback login-claude(string);
    callback submit-code;
    callback login-key;
    callback add-provider;
    callback save-raw;
    callback reload-raw;
    callback open-config-file;
    callback switch-transport;
}

component Rows inherits VerticalLayout {
    callback record-start(string);
    for g in SettingsPageState.groups: VerticalLayout {
        if g.title != "": GroupTitle { text: g.title; }
        Group {
            for r[i] in g.rows: Row {
                label: r.title;
                sub: r.desc;
                value: r.kind == 4 && SettingsPageState.recording-id == r.id ? "キーを押してください…" : (r.kind == 0 || r.kind == 4) ? r.value : "";
                value-color: r.kind == 4 && SettingsPageState.recording-id == r.id ? Theme.accent : Theme.fg-secondary;
                clickable: false;
                separator: i < g.rows.length - 1;
                if r.kind == 1: Switch {
                    on: r.on;
                    toggled(v) => { SettingsPageState.row-toggle(r.id, v); }
                }
                if r.kind == 2: Chip { label: r.value; clicked => { SettingsPageState.row-action(r.id); } }
                if r.kind == 3: Dropdown {
                    options: r.opts;
                    current: r.value;
                    selected(n) => { SettingsPageState.row-choose(r.id, n); }
                }
                if r.kind == 7: Segmented {
                    options: r.opts;
                    cur: r.cur;
                    selected(n) => { SettingsPageState.row-choose(r.id, n); }
                }
                if r.kind == 4: Chip { label: "変更"; clicked => { root.record-start(r.id); } }
                if r.kind == 5: Field {
                    width: 240px;
                    placeholder: "既定";
                    text: r.value;
                    accepted(t) => { SettingsPageState.row-text(r.id, t); }
                }
            }
        }
    }
}

component UsageCards inherits VerticalLayout {
    spacing: 4px;
    for a[ai] in SettingsPageState.usage: VerticalLayout {
        spacing: 0px;
        GroupTitle { text: a.provider + " · " + a.alias + (a.plan != "" ? " · " + a.plan : "") + (a.in-use ? " · 使用中" : ""); }
        Group {
            if a.email != "": Row { label: "メールアドレス"; value: a.email; clickable: false; }
            for b[i] in a.bars: Row {
                label: b.label;
                sub: b.reset;
                value: Math.round(b.pct) + "%";
                pct: b.pct;
                clickable: false;
                separator: i < a.bars.length - 1 || a.credits != "" || a.banked != "";
            }
            if a.credits != "": Row { label: "クレジット残高"; value: a.credits; clickable: false; separator: a.banked != ""; }
            if a.banked != "": Row { label: "リセット券"; value: a.banked; clickable: false; separator: false; }
        }
    }
}

// One page of the settings: its title and the content, scrolling on its own.
component Screen inherits Flickable {
    in property <string> title;
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding: 28px;
        padding-top: 20px;
        padding-bottom: 28px;
        spacing: 0px;
        alignment: start;
        Text { text: root.title; color: Theme.fg; font-size: 18px; font-weight: 700; height: 40px; vertical-alignment: center; }
        @children
    }
}

// The settings: a dialog over the window, the list of sections on the left, the section on the right.
export component SettingsPage inherits Rectangle {
    if SettingsPageState.open: Rectangle {
        background: #00000080;
        TouchArea { clicked => { SettingsPageState.open = false; } }
        Rectangle {
            width: min(1000px, parent.width - 48px);
            height: min(720px, parent.height - 40px);
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            clip: true;
            drop-shadow-blur: 30px;
            drop-shadow-color: #00000066;
            TouchArea { }
            fs := FocusScope {
                key-pressed(e) => {
                    if SettingsPageState.recording-id != "" {
                        if e.text == Key.Escape {
                            SettingsPageState.recording-id = "";
                            return accept;
                        }
                        // Modifier keys alone are not a shortcut.
                        if e.text.character-count == 1 && e.text != Key.Control && e.text != Key.Shift && e.text != Key.Alt && e.text != Key.Meta {
                            SettingsPageState.record(SettingsPageState.recording-id, e.text.to-lowercase(), e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                            SettingsPageState.recording-id = "";
                            return accept;
                        }
                    }
                    reject
                }
                VerticalLayout {
                    HorizontalLayout {
                        height: 52px;
                        padding-left: 20px;
                        padding-right: 12px;
                        Text { text: "設定"; color: Theme.fg; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            IconButton { glyph: Glyph.close; box-size: 30px; clicked => { SettingsPageState.open = false; } }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        vertical-stretch: 1;
                        // Left: the search field and the grouped list of sections
                        Rectangle {
                            width: 250px;
                            VerticalLayout {
                                padding: 12px;
                                padding-top: 16px;
                                spacing: 8px;
                                Field {
                                    placeholder: "検索";
                                    text <=> SettingsPageState.nav-search;
                                    edited(t) => { SettingsPageState.nav-search-changed(t); }
                                }
                                Flickable {
                                    content-height: nav.preferred-height;
                                    nav := VerticalLayout {
                                        spacing: 2px;
                                        alignment: start;
                                        for item in SettingsPageState.sections: Rectangle {
                                            height: item.heading ? 34px : 36px;
                                            border-radius: Theme.radius-row;
                                            background: !item.heading && item.index == SettingsPageState.section ? Theme.selected : (!item.heading && na.has-hover) ? Theme.hover : transparent;
                                            if item.heading: Text {
                                                x: 8px;
                                                y: 10px;
                                                text: item.label;
                                                color: Theme.fg-tertiary;
                                                font-size: 11px;
                                            }
                                            if !item.heading: HorizontalLayout {
                                                padding-left: 10px;
                                                spacing: 10px;
                                                Icon { width: 20px; text: item.glyph; font-size: 18px; color: Theme.fg-secondary; }
                                                Text { text: item.label; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                                            }
                                            na := TouchArea {
                                                enabled: !item.heading;
                                                mouse-cursor: pointer;
                                                clicked => { SettingsPageState.select(item.index); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { width: 1px; background: Theme.border; }
                        // Right: the section
                        Rectangle {
                            horizontal-stretch: 1;
                            if SettingsPageState.layout == 2: AccountsView { }
                            if SettingsPageState.layout == 1: VerticalLayout {
                                padding: 28px;
                                padding-top: 20px;
                                spacing: 4px;
                                Text { text: SettingsPageState.title; color: Theme.fg; font-size: 18px; font-weight: 700; height: 40px; vertical-alignment: center; }
                                Group {
                                    Row {
                                        label: "接続方式";
                                        value: SettingsPageState.transport;
                                        clickable: false;
                                        Chip { label: "切り替え"; clicked => { SettingsPageState.switch-transport(); } }
                                    }
                                }
                                InocodePage { vertical-stretch: 1; }
                            }
                            if SettingsPageState.layout == 7: VerticalLayout {
                                padding: 28px;
                                padding-top: 20px;
                                spacing: 4px;
                                Text { text: SettingsPageState.title; color: Theme.fg; font-size: 18px; font-weight: 700; height: 40px; vertical-alignment: center; }
                                StatsPage { vertical-stretch: 1; }
                            }
                            if SettingsPageState.layout == 5: Screen {
                                title: SettingsPageState.title;
                                if SettingsPageState.loading: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
                                UsageCards { }
                            }
                            if SettingsPageState.layout == 0 || SettingsPageState.layout == 4: Screen {
                                title: SettingsPageState.title;
                                if SettingsPageState.loading: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
                                Rows {
                                    record-start(id) => {
                                        SettingsPageState.recording-id = id;
                                        fs.focus();
                                    }
                                }
                                if SettingsPageState.layout == 4: VerticalLayout {
                                    spacing: 8px;
                                    GroupTitle { text: "InoCode の指示(AGENTS.md)"; }
                                    Rectangle {
                                        height: 240px;
                                        border-radius: Theme.radius-row;
                                        background: Theme.composer;
                                        border-width: 1px;
                                        border-color: Theme.border;
                                        Flickable {
                                            TextInput {
                                                x: 12px;
                                                y: 10px;
                                                width: parent.width - 24px;
                                                height: max(parent.height - 20px, self.preferred-height);
                                                text <=> SettingsPageState.raw-text;
                                                font-size: 13px;
                                                color: Theme.fg;
                                                wrap: word-wrap;
                                                single-line: false;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: SettingsPageState.raw-note; color: Theme.fg-secondary; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                        Chip { label: "再読み込み"; clicked => { SettingsPageState.reload-raw(); } }
                                        Chip { label: "保存"; active: true; clicked => { SettingsPageState.save-raw(); } }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
