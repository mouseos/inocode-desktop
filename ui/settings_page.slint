import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Switch } from "widgets.slint";
import { InocodePage } from "tabs/settings.slint";
import { StatsPage } from "tabs/stats.slint";
import { Chip, Field } from "controls.slint";
import { Group, GroupTitle, Row, ScreenHead } from "ios.slint";
import { AccountsView } from "accounts_page.slint";

export struct NavItem {
    label: string,
    // A group heading (not clickable)
    heading: bool,
}

export struct UsageBar {
    label: string,
    pct: float,
    reset: string,
}

export struct UsageAccount {
    // Human name of the provider (OpenAI, Claude); the cards are grouped by it.
    provider: string,
    alias: string,
    email: string,
    plan: string,
    in-use: bool,
    bars: [UsageBar],
    credits: string,
    banked: string,
}

// A row of the home list: the section it opens.
export struct NavEntry {
    label: string,
    index: int,
}

// A group of the home list.
export struct NavGroup {
    title: string,
    items: [NavEntry],
}

export struct SRow {
    id: string,
    title: string,
    desc: string,
    value: string,
    // 0 text, 1 switch, 2 button (label = value), 3 choice (opts, current = value), 4 shortcut, 5 text input
    kind: int,
    on: bool,
    opts: [string],
    // The index of the current choice in opts (kind 3)
    cur: int,
}

// A group of rows: a heading row (kind 6) starts the next one.
export struct SGroup {
    title: string,
    rows: [SRow],
}

// The one settings page (gear and account menu), src/settings_page.rs.
// `layout` picks what the right side shows: 0 rows, 1 InoCode, 2 account pool, 3 providers, 4 personalization, 5 usage, 6 sign-in.
export global SettingsPageState {
    in-out property <bool> open: false;
    in-out property <int> section: 0;
    in property <int> layout: 0;
    in property <[NavItem]> sections;
    // The home list (the sections in groups) and whether it is the screen shown
    in property <[NavGroup]> home-groups;
    in-out property <bool> home: true;
    in property <[SGroup]> groups;
    in property <[UsageAccount]> usage;
    in property <string> title;
    in property <[SRow]> rows;
    in property <bool> loading: false;
    // The shortcut being recorded ("" when none).
    in-out property <string> recording-id;
    in property <string> plan;
    // Sign-in
    in-out property <string> key-alias;
    in-out property <string> key-value;
    in-out property <bool> show-key: false;
    in property <string> login-note;
    // Sign-in: the providers the server knows, the chosen one and what it offers
    in property <[string]> providers;
    in property <int> provider: 0;
    in property <bool> can-chatgpt: true;
    in property <bool> can-claude: false;
    in property <bool> can-key: true;
    // The code Anthropic shows after a browser sign-in (code#state)
    in-out property <bool> code-open: false;
    in-out property <string> code-value;
    // New model provider
    in-out property <string> prov-name;
    in-out property <string> prov-url;
    in-out property <string> prov-env;
    in-out property <string> prov-key;
    // AGENTS.md
    in-out property <string> raw-text;
    in property <string> raw-note;
    // The transport of the connection (stdio or WS)
    in property <string> transport;

    callback open-page;
    callback go-home;
    callback open-section(int);
    callback open-providers;
    callback open-signin;
    callback select(int);
    callback row-action(string);
    callback row-toggle(string, bool);
    callback row-choose(string, int);
    callback row-text(string, string);
    // id, lower-case key text, ctrl, shift, alt
    callback record(string, string, bool, bool, bool);
    callback login-chatgpt;
    callback pick-provider(int);
    // method: "browser" or "oauthCode"
    callback login-claude(string);
    callback submit-code;
    callback login-key;
    callback add-provider;
    callback save-raw;
    callback reload-raw;
    callback open-config-file;
    callback switch-transport;
}

component Rows inherits VerticalLayout {
    callback record-start(string);
    spacing: 10px;
    for g in SettingsPageState.groups: VerticalLayout {
        spacing: 0px;
        if g.title != "": GroupTitle { text: g.title; }
        Group {
            for r[i] in g.rows: Row {
                label: r.title;
                sub: r.desc;
                value: r.kind == 4 && SettingsPageState.recording-id == r.id ? "キーを押してください…" : (r.kind == 0 || r.kind == 2 || r.kind == 3 || r.kind == 4) ? r.value : "";
                value-color: r.kind == 2 || (r.kind == 4 && SettingsPageState.recording-id == r.id) ? Theme.accent : Theme.fg-secondary;
                chevron: r.kind == 2 || r.kind == 3;
                clickable: r.kind == 2 || r.kind == 3 || r.kind == 4;
                separator: i < g.rows.length - 1;
                clicked => {
                    if r.kind == 2 {
                        SettingsPageState.row-action(r.id);
                    } else if r.kind == 3 {
                        SettingsPageState.row-choose(r.id, Math.mod(r.cur + 1, max(1, r.opts.length)));
                    } else if r.kind == 4 {
                        root.record-start(r.id);
                    }
                }
                if r.kind == 1: VerticalLayout {
                    alignment: center;
                    width: 28px;
                    Switch {
                        on: r.on;
                        toggled(v) => { SettingsPageState.row-toggle(r.id, v); }
                    }
                }
                if r.kind == 5: VerticalLayout {
                    alignment: center;
                    width: 240px;
                    Field {
                        placeholder: "既定";
                        text: r.value;
                        accepted(t) => { SettingsPageState.row-text(r.id, t); }
                    }
                }
            }
        }
    }
}

component UsageCards inherits VerticalLayout {
    spacing: 4px;
    for a[ai] in SettingsPageState.usage: VerticalLayout {
        spacing: 0px;
        GroupTitle { text: a.provider + " · " + a.alias + (a.plan != "" ? " · " + a.plan : "") + (a.in-use ? " · 使用中" : ""); }
        Group {
            if a.email != "": Row { label: "メールアドレス"; value: a.email; clickable: false; }
            for b[i] in a.bars: Row {
                label: b.label;
                sub: b.reset;
                value: Math.round(b.pct) + "%";
                pct: b.pct;
                clickable: false;
                separator: i < a.bars.length - 1 || a.credits != "" || a.banked != "";
            }
            if a.credits != "": Row { label: "クレジット残高"; value: a.credits; clickable: false; separator: a.banked != ""; }
            if a.banked != "": Row { label: "リセット券"; value: a.banked; clickable: false; separator: false; }
        }
    }
}

// One screen of the settings: the way back to the home list, the title and the content.
component Screen inherits Flickable {
    in property <string> title;
    in property <string> back-label: "設定";
    callback back;
    content-height: col.preferred-height;
    col := VerticalLayout {
        padding: 24px;
        padding-left: 40px;
        padding-right: 40px;
        spacing: 10px;
        alignment: start;
        ScreenHead { back-label: root.back-label; title: root.title; back => { root.back(); } }
        @children
    }
}

export component SettingsPage inherits Rectangle {
    if SettingsPageState.open: Rectangle {
        background: Theme.surface;
        TouchArea { }
        fs := FocusScope {
            key-pressed(e) => {
                if SettingsPageState.recording-id != "" {
                    if e.text == Key.Escape {
                        SettingsPageState.recording-id = "";
                        return accept;
                    }
                    // Modifier keys alone are not a shortcut.
                    if e.text.character-count == 1 && e.text != Key.Control && e.text != Key.Shift && e.text != Key.Alt && e.text != Key.Meta {
                        SettingsPageState.record(SettingsPageState.recording-id, e.text.to-lowercase(), e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                        SettingsPageState.recording-id = "";
                        return accept;
                    }
                }
                reject
            }
            // The home list: the sections in groups
            if SettingsPageState.home: Screen {
                title: "設定";
                back-label: "戻る";
                back => { SettingsPageState.open = false; }
                for g in SettingsPageState.home-groups: VerticalLayout {
                    spacing: 0px;
                    GroupTitle { text: g.title; }
                    Group {
                        for it[i] in g.items: Row {
                            label: it.label;
                            chevron: true;
                            separator: i < g.items.length - 1;
                            clicked => { SettingsPageState.select(it.index); }
                        }
                    }
                }
            }
            if !SettingsPageState.home && SettingsPageState.layout == 2: AccountsView { }
            if !SettingsPageState.home && SettingsPageState.layout == 1: VerticalLayout {
                padding: 24px;
                padding-left: 40px;
                padding-right: 40px;
                spacing: 10px;
                ScreenHead { back-label: "設定"; title: SettingsPageState.title; back => { SettingsPageState.go-home(); } }
                Group {
                    Row {
                        label: "接続方式";
                        value: SettingsPageState.transport;
                        value-color: Theme.accent;
                        chevron: true;
                        separator: false;
                        clicked => { SettingsPageState.switch-transport(); }
                    }
                }
                InocodePage { vertical-stretch: 1; }
            }
            if !SettingsPageState.home && SettingsPageState.layout == 7: VerticalLayout {
                padding: 24px;
                padding-left: 40px;
                padding-right: 40px;
                spacing: 10px;
                ScreenHead { back-label: "設定"; title: SettingsPageState.title; back => { SettingsPageState.go-home(); } }
                StatsPage { vertical-stretch: 1; }
            }
            if !SettingsPageState.home && SettingsPageState.layout == 5: Screen {
                title: SettingsPageState.title;
                back => { SettingsPageState.go-home(); }
                if SettingsPageState.loading: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
                UsageCards { }
            }
            if !SettingsPageState.home && (SettingsPageState.layout == 0 || SettingsPageState.layout == 3 || SettingsPageState.layout == 4): Screen {
                title: SettingsPageState.title;
                back => { SettingsPageState.go-home(); }
                if SettingsPageState.loading: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
                Rows {
                    record-start(id) => {
                        SettingsPageState.recording-id = id;
                        fs.focus();
                    }
                }
                if SettingsPageState.layout == 4: VerticalLayout {
                    spacing: 8px;
                    GroupTitle { text: "Codex の指示(AGENTS.md)"; }
                    Rectangle {
                        height: 240px;
                        border-radius: 12px;
                        background: Theme.bubble;
                        Flickable {
                            TextInput {
                                x: 14px;
                                y: 10px;
                                width: parent.width - 28px;
                                height: max(parent.height - 20px, self.preferred-height);
                                text <=> SettingsPageState.raw-text;
                                font-size: 13px;
                                color: Theme.fg;
                                wrap: word-wrap;
                                single-line: false;
                            }
                        }
                    }
                    Group {
                        Row { label: "再読み込み"; sub: SettingsPageState.raw-note; clicked => { SettingsPageState.reload-raw(); } }
                        Row { label: "保存"; value-color: Theme.accent; separator: false; clicked => { SettingsPageState.save-raw(); } }
                    }
                }
                if SettingsPageState.layout == 3: VerticalLayout {
                    spacing: 0px;
                    GroupTitle { text: "プロバイダを追加"; }
                    Group {
                        Row { label: "名前"; clickable: false; VerticalLayout { alignment: center; width: 260px; Field { text <=> SettingsPageState.prov-name; } } }
                        Row { label: "base URL"; sub: "OpenAI 互換のエンドポイント"; clickable: false; VerticalLayout { alignment: center; width: 260px; Field { text <=> SettingsPageState.prov-url; } } }
                        Row { label: "API キーの環境変数名"; clickable: false; VerticalLayout { alignment: center; width: 260px; Field { text <=> SettingsPageState.prov-env; } } }
                        Row {
                            label: "API キーの値";
                            sub: "環境変数名と、どちらか";
                            clickable: false;
                            VerticalLayout { alignment: center; width: 260px; Field { secret: !SettingsPageState.show-key; text <=> SettingsPageState.prov-key; } }
                        }
                        Row { label: SettingsPageState.show-key ? "キーを隠す" : "キーを表示"; clicked => { SettingsPageState.show-key = !SettingsPageState.show-key; } }
                        Row { label: "追加"; value-color: Theme.accent; separator: false; clicked => { SettingsPageState.add-provider(); } }
                    }
                    if SettingsPageState.login-note != "": Text { text: SettingsPageState.login-note; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }
}
