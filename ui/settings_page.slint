import { Theme } from "theme.slint";
import { Icon, Glyph } from "icons.slint";
import { IconButton, Switch } from "widgets.slint";
import { InocodePage, AccountsPage } from "tabs/settings.slint";

export struct SRow {
    id: string,
    title: string,
    desc: string,
    value: string,
    // 0 text, 1 switch, 2 button (label = value), 3 choice (opts, current = value), 4 shortcut
    kind: int,
    on: bool,
    opts: [string],
}

// Full-page settings opened from the gear and the account menu (src/settings_page.rs).
// Sections 3 (InoCode) and 4 (account) embed the pages of the InoCode feature settings and the
// account pool; the other sections are generic rows filled from the server.
export global SettingsPageState {
    in-out property <bool> open: false;
    in-out property <int> section: 0;
    in property <[string]> sections;
    in property <string> title;
    in property <[SRow]> rows;
    in property <bool> loading: false;
    // The shortcut being recorded ("" when none).
    in-out property <string> recording-id;
    // Plan label and the log-out button of the account section.
    in property <string> plan;

    callback open-page;
    callback select(int);
    callback row-action(string);
    callback row-toggle(string, bool);
    callback row-choose(string, int);
    // id, lower-case key text, ctrl, shift, alt
    callback record(string, string, bool, bool, bool);
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 26px;
    width: t.preferred-width + 20px;
    border-radius: Theme.radius-row;
    background: root.active ? Theme.fg : ta.has-hover ? Theme.pressed : Theme.selected;
    t := Text {
        text: root.label;
        color: root.active ? Theme.surface : Theme.fg;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component SettingsPage inherits Rectangle {
    if SettingsPageState.open: Rectangle {
        background: Theme.surface;
        TouchArea { }
        fs := FocusScope {
            key-pressed(e) => {
                if SettingsPageState.recording-id != "" {
                    if e.text == Key.Escape {
                        SettingsPageState.recording-id = "";
                        return accept;
                    }
                    // Modifier keys alone are not a shortcut.
                    if e.text.character-count == 1 && e.text != Key.Control && e.text != Key.Shift && e.text != Key.Alt && e.text != Key.Meta {
                        SettingsPageState.record(SettingsPageState.recording-id, e.text.to-lowercase(), e.modifiers.control, e.modifiers.shift, e.modifiers.alt);
                        SettingsPageState.recording-id = "";
                        return accept;
                    }
                }
                reject
            }
            HorizontalLayout {
                // Left: back arrow, title and the section list
                Rectangle {
                    width: 240px;
                    background: Theme.sidebar;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;
                        HorizontalLayout {
                            height: 36px;
                            spacing: 4px;
                            IconButton {
                                y: 6px;
                                glyph: Glyph.arrow-back;
                                clicked => { SettingsPageState.open = false; }
                            }
                            Text { text: "設定"; color: Theme.fg; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                        }
                        for name[i] in SettingsPageState.sections: Rectangle {
                            height: 28px;
                            border-radius: Theme.radius-row;
                            background: i == SettingsPageState.section ? Theme.selected : na.has-hover ? Theme.hover : transparent;
                            Text { x: 10px; text: name; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                            na := TouchArea { mouse-cursor: pointer; clicked => { SettingsPageState.select(i); } }
                        }
                    }
                }
                // Right: the section
                Rectangle {
                    horizontal-stretch: 1;
                    if SettingsPageState.section == 3: Rectangle {
                        InocodePage { }
                    }
                    if SettingsPageState.section == 4: VerticalLayout {
                        HorizontalLayout {
                            height: 52px;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 12px;
                            spacing: 12px;
                            Text { text: "プラン"; color: Theme.fg; font-size: 13px; vertical-alignment: center; }
                            Text { text: SettingsPageState.plan; color: Theme.fg-secondary; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Chip { label: "ログアウト"; clicked => { SettingsPageState.row-action("logout"); } }
                            }
                        }
                        AccountsPage { vertical-stretch: 1; }
                    }
                    if SettingsPageState.section != 3 && SettingsPageState.section != 4: Flickable {
                        content-height: body.preferred-height;
                        body := VerticalLayout {
                            padding: 24px;
                            padding-left: 40px;
                            padding-right: 40px;
                            spacing: 4px;
                            alignment: start;
                            Text { text: SettingsPageState.title; color: Theme.fg; font-size: 20px; font-weight: 600; height: 40px; vertical-alignment: center; }
                            if SettingsPageState.loading: Text { text: "読み込み中…"; color: Theme.fg-tertiary; font-size: 13px; }
                            for r in SettingsPageState.rows: Rectangle {
                                height: max(44px, c.preferred-height + 12px);
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                                c := HorizontalLayout {
                                    padding-top: 6px;
                                    padding-bottom: 6px;
                                    spacing: 12px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: r.title; color: Theme.fg; font-size: 13px; wrap: word-wrap; }
                                        if r.desc != "": Text { text: r.desc; color: Theme.fg-secondary; font-size: 12px; wrap: word-wrap; }
                                    }
                                    if r.kind == 0: Text {
                                        text: r.value;
                                        color: Theme.fg-secondary;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        overflow: elide;
                                        max-width: 320px;
                                    }
                                    if r.kind == 1: Rectangle {
                                        width: 28px;
                                        Switch {
                                            y: (parent.height - self.height) / 2;
                                            on: r.on;
                                            toggled(v) => { SettingsPageState.row-toggle(r.id, v); }
                                        }
                                    }
                                    if r.kind == 2: VerticalLayout {
                                        alignment: center;
                                        Chip { label: r.value; clicked => { SettingsPageState.row-action(r.id); } }
                                    }
                                    if r.kind == 3: VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 4px;
                                            alignment: end;
                                            for o[i] in r.opts: Chip {
                                                label: o;
                                                active: o == r.value;
                                                clicked => { SettingsPageState.row-choose(r.id, i); }
                                            }
                                        }
                                    }
                                    if r.kind == 4: HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: SettingsPageState.recording-id == r.id ? "キーを押してください…" : r.value;
                                            color: SettingsPageState.recording-id == r.id ? Theme.accent : Theme.fg-secondary;
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Chip {
                                                label: "変更";
                                                clicked => {
                                                    SettingsPageState.recording-id = r.id;
                                                    fs.focus();
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
