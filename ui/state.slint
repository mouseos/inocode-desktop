import { IntelligenceState, PermState, ProjectState } from "pickers.slint";
import { ProjectItem } from "sidebar.slint";
import { DiscoveryState } from "settings.slint";
import { MdRow } from "markdown.slint";
import { ReplyRef } from "reply.slint";

// One row of a diff in the chat. kind: 0 context, 1 added, 2 removed, 3 file heading (text = the
// name, added / removed = "+3" / "−1"), 4 gap between hunks, 5 note.
export struct DiffRow {
    kind: int,
    num: string,
    text: string,
    added: string,
    removed: string,
}

// One line of an approval's body (command, diff, permissions). kind: 0 plain, 1 added,
// 2 removed, 3 file header, 4 note.
export struct ALine {
    text: string,
    kind: int,
}

export struct Approval {
    key: string,
    title: string,
    detail: string,
    // One line over the body ("3 ファイル  +12 −4").
    summary: string,
    lines: [ALine],
    // The body is long: it can be opened to read all of it.
    long: bool,
    // An MCP input request: decline or continue only.
    simple: bool,
}

export struct Message {
    id: string,
    // "user", "assistant" or "tool" (collapsed command summary row)
    role: string,
    text: string,
    // Body of an expandable tool row (command output, file diff, reasoning summary, plan).
    detail: string,
    // The blocks of an assistant answer (markdown).
    blocks: [MdRow],
    // Its number "#<turn>.<item>" (user and assistant messages; empty until the server named it).
    ref-id: string,
    // Where it sits in the thread: what the server needs to give the number.
    turn-id: string,
    item-index: int,
    // A user message that replies to others: those, and the text without the reply lines.
    refs: [ReplyRef],
    shown: string,
    // The pictures sent with a user message
    images: [image],
    // The body of a tool row that is a diff, row by row
    diff: [DiffRow],
}

// チャット画面の状態とコールバックをここに集約する。Rust は app.global::<AppState>() で触り、
// 各コンポーネントは AppState を直接読む(AppWindow → Home → Composer の受け渡しはしない)。
export global AppState {
    in property <[Message]> messages;
    // Tool rows start open (the snapshot entry INOCODE_GUI_DIFF shows a diff this way)
    in property <bool> tools-open: false;
    in property <[Approval]> approvals;
    in property <[ProjectItem]> projects;
    in property <bool> busy: false;
    in property <string> status: "接続中…";
    // 0 info, 1 ok, 2 warning, 3 error
    in property <int> status-level: 0;
    in property <string> transport: "WS";
    in property <string> session-title: "新しいセッション";
    in property <IntelligenceState> intelligence;
    in property <PermState> perm;
    in property <ProjectState> project;
    in-out property <bool> full-confirm-open: false;
    in-out property <bool> settings-open: false;
    in property <DiscoveryState> discovery;
    in property <int> context-percent: 0;
    in property <string> usage-text;
    in property <string> rate-text;
    in property <string> cwd-text;
    in property <string> account-label: "ローカル";
    in property <bool> logged-in: true;
    // The server is not reachable: reconnect now instead of waiting for the retry.
    in property <bool> disconnected: false;
    // The folder cannot be written (the server runs it read-only although writing was chosen).
    in property <string> sandbox-notice;
    in property <bool> sandbox-can-setup: false;

    callback search-model(string);
    callback pick-effort(int);
    callback pick-model(int);
    callback reset-model;
    callback pick-perm(int);
    callback pick-project(int);
    callback confirm-full;
    callback cancel-full;
    callback toggle-discovery;
    callback headroom-up;
    callback headroom-down;
    callback run-discovery;
    callback login;
    callback new-chat-in(string);
    callback new-chat;
    callback open-thread(string);
    callback interrupt;
    callback decide(string, string);
    callback switch-transport;
    callback reconnect;
    callback sandbox-setup;
    callback sandbox-dismiss;
}
